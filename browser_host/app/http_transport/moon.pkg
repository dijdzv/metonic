import {
  "local/p0/capabilities/http",
  "local/browser_host/input_binding",
  "local/websys-input" @input_dom,
  "moonbitlang/async/js_async",
  "moonbitlang/async",
}

supported_targets = "+js+wasm-gc"
// JS needs the official AbortController type; WasmGC supplies an abort callback.
// Imports cannot currently be restricted by target like source files can.

options(
  warn_list: "-29",
  targets: { "http_js.mbt": [ "js" ], "http_wasm.mbt": [ "wasm-gc" ] },
)

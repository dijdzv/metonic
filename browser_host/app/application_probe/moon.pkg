import {
  "local/p0/core/application" @app,
  "local/p0/core/application_task" @task,
  "local/p0/core/semantics",
  "local/browser_host/application_host" @host,
  "local/p0/examples/notes/operations_fixture" @operations,
  "moonbitlang/async",
  "local/metonic_async/clock" @production_clock,
  "local/p0/effects/clock",
}

pkgtype(kind: "foreign_library")

supported_targets = "+js+wasm-gc"

options(
  link: {
    "js": { "format": "esm" },
    "wasm-gc": {
      "imported-string-constants": "_",
      "use-js-builtin-string": true,
    },
  },
)

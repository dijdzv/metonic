import {
  "local/p0/examples/p0/browser" @app,
  "local/websys-input" @input_dom,
  "moonbitlang/async/js_async",
  "moonbitlang/async",
}

pkgtype(kind: "foreign_library")

supported_targets = "+js+wasm-gc"

options(
  targets: {
    "input_js.mbt": [ "js" ],
    "input_wasm.mbt": [ "wasm-gc" ],
    "gpu_js.mbt": [ "js" ],
    "gpu_wasm.mbt": [ "wasm-gc" ],
    "http_js.mbt": [ "js" ],
    "http_wasm.mbt": [ "wasm-gc" ],
    "host_js.mbt": [ "js" ],
    "host_wasm.mbt": [ "wasm-gc" ],
    "font_js.mbt": [ "js" ],
    "font_wasm.mbt": [ "wasm-gc" ],
  },
  link: {
    "js": { "format": "esm" },
    "wasm-gc": {
      "imported-string-constants": "_",
      "use-js-builtin-string": true,
    },
  },
)

import {
  "local/browser_host/dom_view",
  "local/browser_host/font_loader",
  "local/metonic_async/clock" @production_clock,
  "local/browser_host/http_transport",
  "local/browser_host/gpu_renderer",
  "local/browser_host/input_binding",
  "local/p0/effects/clock",
  "local/p0/examples/p0/user_load",
  "local/metonic_async/http" @timed,
  "local/p0/examples/p0/browser" @app,
  "local/websys-input" @input_dom,
  "moonbitlang/async",
}

pkgtype(kind: "foreign_library")

supported_targets = "+js+wasm-gc"

options(
  targets: {
    "http_js.mbt": [ "js" ],
    "http_wasm.mbt": [ "wasm-gc" ],
    "host_js.mbt": [ "js" ],
    "host_wasm.mbt": [ "wasm-gc" ],
  },
  link: {
    "js": { "format": "esm" },
    "wasm-gc": {
      "imported-string-constants": "_",
      "use-js-builtin-string": true,
    },
  },
)

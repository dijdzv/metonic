// Input-only binding surface. Explicit capture/direction/init arguments narrow
// the optional standard signatures; unrelated HTTP and GPU APIs are excluded.
interface Window {
  unsigned long requestAnimationFrame(FrameRequestCallback callback);
  undefined cancelAnimationFrame(unsigned long handle);
};
callback FrameRequestCallback = undefined (double timestamp);
interface EventTarget {
  undefined addEventListener(DOMString type, EventListener callback, boolean capture);
  undefined removeEventListener(DOMString type, EventListener callback, boolean capture);
  boolean dispatchEvent(Event event);
};
callback EventListener = undefined (Event event);
interface Document : EventTarget {
  Element createElement(DOMString localName);
  Element? getElementById(DOMString id);
  readonly attribute Element? activeElement;
};
interface Node : EventTarget {
  Node appendChild(Node child);
  Node removeChild(Node child);
  attribute DOMString? textContent;
  boolean isSameNode(Node? otherNode);
};
interface Element : Node {
  DOMRectReadOnly getBoundingClientRect();
  undefined moveBefore(Node movedNode, Node? referenceNode);
  undefined setAttribute(DOMString qualifiedName, DOMString value);
  boolean hasAttribute(DOMString qualifiedName);
  undefined removeAttribute(DOMString qualifiedName);
  attribute DOMString id;
  attribute double scrollLeft;
  attribute double scrollTop;
  readonly attribute long scrollHeight;
  readonly attribute long clientHeight;
};
interface HTMLElement : Element { undefined focus(); };
partial interface HTMLElement {
  readonly attribute long offsetLeft;
  readonly attribute long offsetTop;
  readonly attribute CSSStyleDeclaration style;
};
partial interface Element { readonly attribute DOMTokenList classList; };
interface DOMTokenList { undefined add(DOMString token); };
interface CSSStyleDeclaration {
  undefined setProperty(DOMString property, DOMString value, DOMString priority);
};
interface HTMLInputElement : HTMLElement {
  attribute boolean disabled;
  attribute boolean readOnly;
  undefined setSelectionRange(unsigned long start, unsigned long end, DOMString direction);
  attribute DOMString value;
  readonly attribute unsigned long? selectionStart;
  readonly attribute unsigned long? selectionEnd;
  readonly attribute DOMString? selectionDirection;
};
interface HTMLButtonElement : HTMLElement {
  attribute boolean disabled;
};
interface HTMLTextAreaElement : HTMLElement {
  attribute boolean disabled;
  attribute boolean readOnly;
  undefined setSelectionRange(unsigned long start, unsigned long end, DOMString direction);
  attribute DOMString value;
  readonly attribute unsigned long selectionStart;
  readonly attribute unsigned long selectionEnd;
  readonly attribute DOMString selectionDirection;
};
interface Event {
  constructor(DOMString type, EventInit init);
  readonly attribute DOMString type;
  undefined preventDefault();
  undefined stopPropagation();
};
dictionary EventInit {
  boolean bubbles = false;
  boolean cancelable = false;
  boolean composed = false;
};
interface UIEvent : Event {};
interface MouseEvent : UIEvent {
  readonly attribute long clientX;
  readonly attribute long clientY;
  readonly attribute boolean ctrlKey;
};
interface WheelEvent : MouseEvent {
  readonly attribute double deltaY;
  readonly attribute unsigned long deltaMode;
};
interface KeyboardEvent : UIEvent {
  readonly attribute DOMString key;
  readonly attribute boolean isComposing;
};
interface DOMRectReadOnly {
  readonly attribute double left;
  readonly attribute double top;
};
interface InputEvent : UIEvent {
  readonly attribute boolean isComposing;
};
interface CompositionEvent : UIEvent {
  constructor(DOMString type, CompositionEventInit init);
  readonly attribute DOMString data;
};
dictionary CompositionEventInit : EventInit {
  DOMString data = "";
};

import {
  "local/metonic_quote/board",
  "local/native_host/application" @host,
  "local/native_host/window_host",
  "local/metonic_async/clock" @production_clock,
  "local/p0/capabilities/clock",
  "moonbitlang/async",
}

pkgtype(kind: "executable")

supported_targets = "native"

options(
  link: {
    "native": {
      "cc-link-flags": "/link /SUBSYSTEM:WINDOWS /ENTRY:mainCRTStartup",
    },
  },
)

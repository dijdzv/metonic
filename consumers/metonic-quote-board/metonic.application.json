{
  "schema_version": 1,
  "targets": {
    "browser": {
      "workspace": "browser",
      "members": ["app", "../common"],
      "entries": {
        "main": {
          "entry_package": "app/main",
          "artifact": "local/metonic_quote_browser/main"
        },
        "diagnostics": {
          "entry_package": "app/diagnostics",
          "artifact": "local/metonic_quote_browser/diagnostics"
        }
      }
    },
    "native": {
      "workspace": "native",
      "members": ["../common", "."],
      "entries": {
        "main": {
          "entry_package": "main",
          "artifact": "local/metonic_quote_native/main"
        },
        "probe": {
          "entry_package": "probe",
          "artifact": "local/metonic_quote_native/probe"
        },
        "release-probe": {
          "entry_package": "release_probe",
          "artifact": "local/metonic_quote_native/release_probe"
        }
      }
    }
  }
}

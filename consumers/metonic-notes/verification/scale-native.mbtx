import {
  "moonbitlang/async@0.21.2",
  "moonbitlang/async@0.21.2/fs",
  "moonbitlang/async@0.21.2/process",
  "moonbitlang/core/json",
}

///|
async fn run_probe(
  sample : Int,
  executable : String,
  directory : String,
  output : String,
  reopen : Bool,
) -> Json {
  let stage = if reopen { "reopen" } else { "initial" }
  let prefix = if reopen {
    "NOTES_SCALE_NATIVE_REOPEN_OK "
  } else {
    "NOTES_SCALE_NATIVE_OK "
  }
  let log_path = output +
    "/native-sample-" +
    sample.to_string() +
    "-" +
    stage +
    ".log"
  let log = @process.redirect_to_file(log_path)
  let code = @async.with_timeout(180000, () => {
    @process.run(
      executable,
      [],
      extra_env={
        "METONIC_NOTES_DATA": directory,
        "METONIC_SCALE_REOPEN": if reopen {
          "1"
        } else {
          "0"
        },
      },
      stdout=log,
      stderr=log,
      no_console_window=true,
    )
  })
  log.close()
  assert_eq(code, 0, msg="native scale probe failed: " + log_path)
  let line = @fs.read_file(log_path)
    .text()
    .split("\n")
    .find_first(line => line.has_prefix(prefix))
    .unwrap()
  @json.parse(line.strip_prefix(prefix).unwrap().to_owned())
}

///|
async fn run_sample(
  sample : Int,
  executable : String,
  fixture : Bytes,
  output : String,
) -> Json {
  let directory = @fs.tmpdir(prefix="memo-scale-native-")
  let resolved = @fs.realpath(directory)
  defer {
    assert_eq(@fs.realpath(directory), resolved)
    @fs.rmdir(directory, recursive=true)
  }
  @fs.write_file(directory + "/snapshot", fixture)
  let steps = run_probe(sample, executable, directory, output, false)
  assert_true(
    @fs.read_file(directory + "/snapshot")
    .text()
    .contains("Memo 10 alpha edited"),
  )
  let reopened = run_probe(sample, executable, directory, output, true)
  println(
    "NOTES_SCALE_NATIVE_SAMPLE sample=" + sample.to_string() + " result=ok",
  )
  { "sample": sample, "steps": steps, "reopen": reopened }
}

///|
async fn main {
  let root = @fs.realpath(".")
  let output = root + "/.work/scale"
  let fixture = @fs.read_file(output + "/fixture.snapshot").binary()
  let executable = root +
    "/native/.metonic-build/native/debug/build/local/metonic_notes_native/scale_probe/scale_probe.exe"
  let results : Array[Json] = []
  for sample in 0..<4 {
    results.push(run_sample(sample, executable, fixture, output))
  }
  @fs.write_file(
    output + "/native-baseline.json",
    Json::array(results).stringify(),
  )
  println("NOTES_SCALE_NATIVE_BASELINE_OK warmup=1 measured=3")
}

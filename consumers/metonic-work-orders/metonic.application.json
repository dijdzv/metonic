{
  "schema_version": 1,
  "targets": {
    "browser": {
      "workspace": "browser",
      "members": ["app", "../common"],
      "entries": {
        "main": {
          "entry_package": "app/main",
          "artifact": "local/metonic_work_orders_browser/main"
        }
      }
    },
    "native": {
      "workspace": "native",
      "members": ["../common", "."],
      "entries": {
        "main": {
          "entry_package": "main",
          "artifact": "local/metonic_work_orders_native/main"
        },
        "dev": {
          "entry_package": "dev",
          "artifact": "local/metonic_work_orders_native/dev"
        }
      }
    }
  }
}

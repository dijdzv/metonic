import {
  "moonbitlang/async@0.21.2",
  "moonbitlang/async@0.21.2/fs",
  "moonbitlang/async@0.21.2/process",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.1/crypto",
}

///|
struct Crate {
  name : String
  version : String
} derive(FromJson)

///|
struct Usage {
  crate : Crate
} derive(FromJson)

///|
struct License {
  id : String
  text : String
  used_by : Array[Usage]
} derive(FromJson)

///|
struct Report {
  licenses : Array[License]
} derive(FromJson)

///|
async fn acquire(url : String, path : String, digest : String) -> Unit {
  if !@fs.exists(path) {
    assert_eq(
      @process.run(
        "curl.exe",
        ["-fsSL", "--retry", "2", url, "-o", path],
        no_console_window=true,
      ),
      0,
    )
  }
  assert_eq(
    @crypto.bytes_to_hex_string(@crypto.sha256(@fs.read_file(path).binary())),
    digest,
    msg="SHA256 mismatch: " + path,
  )
}

///|
async fn main {
  @async.with_timeout(300000, async fn() {
    let root = ".work/native-rust-notices"
    if !@fs.exists(root) {
      @fs.mkdir(root, recursive=true)
    }
    let output = root + "/distribution"
    if !@fs.exists(output) {
      @fs.mkdir(output, recursive=true)
    }
    let inventory_path = output + "/inventory.json"
    if @fs.exists(inventory_path) {
      @fs.remove(inventory_path)
    }
    let cargo_archive = "cargo-about-0.9.2-x86_64-pc-windows-msvc"
    acquire(
      "https://github.com/EmbarkStudios/cargo-about/releases/download/0.9.2/" +
      cargo_archive +
      ".tar.gz",
      root + "/cargo-about.tar.gz",
      "1c03e5890238562497c2d89a3b75b02560af349c1fc3e713d3284f532a5cd748",
    )
    assert_eq(
      @process.run(
        "tar",
        ["-xf", root + "/cargo-about.tar.gz", "-C", root],
        no_console_window=true,
      ),
      0,
    )
    let revision = "6aed50955d934ac36049ba8d002034841633ae02"
    acquire(
      "https://codeload.github.com/gfx-rs/wgpu-native/tar.gz/" + revision,
      root + "/wgpu-source.tar.gz",
      "bff001ca2f891d13dd9b5bd1fd6efc2003c54cfed9cdb21d3f84fc16d549e335",
    )
    assert_eq(
      @process.run(
        "tar",
        ["-xf", root + "/wgpu-source.tar.gz", "-C", root],
        no_console_window=true,
      ),
      0,
    )
    acquire(
      "https://raw.githubusercontent.com/AccessKit/accesskit/c88605b96d04431f9c3c792464a0f2f253480e94/LICENSE-MIT",
      root + "/accesskit-MIT",
      "23f18e03dc49df91622fe2a76176497404e46ced8a715d9d2b67a7446571cca3",
    )
    let accesskit = ".work/accesskit-focus-source/accesskit-c-0.22.3"
    assert_true(
      @fs.exists(accesskit + "/Cargo.toml"),
      msg="Prepare the native AccessKit dependency first",
    )
    let tool = @fs.realpath(root + "/" + cargo_archive + "/cargo-about.exe")
    let sources : Array[Json] = []
    for
      (name, manifest) in [
        ("accesskit", accesskit + "/Cargo.toml"),
        ("wgpu", root + "/wgpu-native-" + revision + "/Cargo.toml"),
      ] {
      let raw = root + "/" + name + "-report.json"
      let (code, stdout, stderr) = @process.collect_output(
        tool,
        [
          "generate",
          "--locked",
          "--fail",
          "--format",
          "json",
          "--config",
          "scripts/native-notices/" + name + ".toml",
          "--manifest-path",
          manifest,
          "--output-file",
          raw,
        ],
        no_console_window=true,
      )
      assert_eq(code, 0, msg=stdout.text() + stderr.text())
      // cargo-about can fall back successfully after a failed clarification.
      assert_true(stderr.text() == "", msg=stderr.text())
      let report : Report = @json.from_json(
        @json.parse(@fs.read_file(raw).text()),
      )
      assert_true(report.licenses.length() > 0)
      let text = StringBuilder()
      text.write_string(
        "Third-party notices: " +
        name +
        "\nWindows x86_64 default-feature dependency graph, including build tools.\n\n",
      )
      for license in report.licenses {
        assert_true(
          !license.text.contains("<year>") &&
          !license.text.contains("<copyright holders>"),
          msg="Unresolved license template in " + name,
        )
        text.write_string("--- " + license.id + " ---\n")
        for usage in license.used_by {
          text.write_string(usage.crate.name + " " + usage.crate.version + "\n")
        }
        text.write_string("\n" + license.text + "\n\n")
      }
      @fs.write_file(output + "/LICENSES-" + name + ".txt", text.to_string())
      let lock = manifest.strip_suffix("Cargo.toml").unwrap().to_owned() +
        "Cargo.lock"
      sources.push({
        "component": name,
        "cargo_lock_sha256": @crypto.bytes_to_hex_string(
          @crypto.sha256(@fs.read_file(lock).binary()),
        ),
        "configuration_sha256": @crypto.bytes_to_hex_string(
          @crypto.sha256(
            @fs.read_file("scripts/native-notices/" + name + ".toml").binary(),
          ),
        ),
      })
    }
    @fs.write_file(
      output + "/LICENSE-accesskit-chromium.txt",
      @fs.read_file(accesskit + "/LICENSE.chromium").binary(),
    )
    let files : Array[Json] = []
    for
      name in [
        "LICENSES-accesskit.txt", "LICENSES-wgpu.txt", "LICENSE-accesskit-chromium.txt",
      ] {
      let bytes = @fs.read_file(output + "/" + name).binary()
      files.push({
        "path": name,
        "bytes": bytes.length(),
        "sha256": @crypto.bytes_to_hex_string(@crypto.sha256(bytes)),
      })
    }
    let inventory : Json = {
      "schema_version": 1,
      "tool": "cargo-about 0.9.2",
      "wgpu_revision": revision,
      "sources": sources,
      "files": files,
    }
    @fs.write_file(inventory_path, inventory.stringify(indent=2))
    println("NATIVE_RUST_NOTICES_OK output=" + output)
  })
}

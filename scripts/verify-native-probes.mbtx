import {
  "moonbitlang/async@0.21.2",
  "moonbitlang/async@0.21.2/fs",
  "moonbitlang/async@0.21.2/process",
  "moonbitlang/async@0.21.2/http",
  "moonbitlang/async@0.21.2/socket",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
}

///|
suberror ProbeFailure {
  ProbeFailure(String)
} derive(Debug)

///|
struct StreamState {
  bytes : Array[Byte]
  mut overflow : Bool
}

///|
fn fail(message : String) -> Unit raise Error {
  raise ProbeFailure(message)
}

///|
fn require(value : Bool, message : String) -> Unit raise Error {
  if !value {
    fail(message)
  }
}

///|
async fn drain(
  reader : @process.ReadFromProcess,
  state : Ref[StreamState],
  process : @process.Process,
) -> Unit {
  while !state.val.overflow {
    match reader.read_some(max_len=4096) {
      None => break
      Some(chunk) => {
        let remaining = 65536 - state.val.bytes.length()
        let count = if chunk.length() < remaining {
          chunk.length()
        } else {
          remaining
        }
        for i = 0; i < count; i = i + 1 {
          state.val.bytes.push(chunk[i])
        }
        if count < chunk.length() {
          state.val.overflow = true
          process.cancel()
        }
      }
    }
  }
}

///|
fn lines(text : String) -> Array[String] {
  text
  .replace_all(old="\r\n", new="\n")
  .split("\n")
  .map(fn(value) { value.to_owned() })
  .to_array()
}

///|
fn exact_line(text : String, expected : String) -> Bool {
  for line in lines(text) {
    if line == expected {
      return true
    }
  }
  false
}

///|
fn exact_line_count(text : String, expected : String) -> Int {
  let mut count = 0
  for line in lines(text) {
    if line == expected {
      count += 1
    }
  }
  count
}

///|
fn shutdown_ms(text : String) -> Int? {
  let prefix = "NATIVE_ASYNC_SHUTDOWN_MS="
  let mut found : Int? = None
  for line in lines(text) {
    if line.has_prefix(prefix) {
      let suffix = line[prefix.length():].to_owned()
      if suffix.length() == 0 {
        return None
      }
      let mut value = 0
      for index = 0; index < suffix.length(); index = index + 1 {
        let digit = suffix.code_unit_at(index).to_int() - 48
        if digit < 0 || digit > 9 || value > 3999 {
          return None
        }
        value = value * 10 + digit
      }
      if found is Some(_) {
        return None
      }
      found = Some(value)
    }
  }
  found
}

///|
fn marker_number(text : String, prefix : String) -> Int? {
  let mut found : Int? = None
  for line in lines(text) {
    if line.has_prefix(prefix) {
      let suffix = line[prefix.length():].to_owned()
      if suffix == "" {
        return None
      }
      let mut value = 0
      for index = 0; index < suffix.length(); index = index + 1 {
        let digit = suffix.code_unit_at(index).to_int() - 48
        if digit < 0 ||
          digit > 9 ||
          value > 214748364 ||
          (value == 214748364 && digit > 7) {
          return None
        }
        value = value * 10 + digit
      }
      if found is Some(_) {
        return None
      }
      found = Some(value)
    }
  }
  found
}

///|
fn json_null() -> Json {
  Json::null()
}

///|
fn require_json_int(
  values : Map[String, Json],
  name : String,
  expected : Int64,
) -> Unit raise Error {
  match values.get(name) {
    Some(Json::Number(value, ..)) if value.to_int64().to_double() == value &&
      value.to_int64() == expected => ()
    _ => fail("invalid integer field: " + name)
  }
}

///|
fn require_json_min_int(
  values : Map[String, Json],
  name : String,
  minimum : Int64,
) -> Unit raise Error {
  match values.get(name) {
    Some(Json::Number(value, ..)) if value.to_int64().to_double() == value &&
      value.to_int64() >= minimum => ()
    _ => fail("invalid integer field: " + name)
  }
}

///|
fn require_json_true(
  values : Map[String, Json],
  name : String,
) -> Unit raise Error {
  match values.get(name) {
    Some(Json::True) => ()
    _ => fail("invalid boolean field: " + name)
  }
}

///|
fn require_json_string(
  values : Map[String, Json],
  name : String,
) -> Unit raise Error {
  match values.get(name) {
    Some(Json::String(value)) if value != "" => ()
    _ => fail("invalid string field: " + name)
  }
}

///|
fn require_native_async_result(text : String) -> Unit raise Error {
  let mut found : Json? = None
  for line in lines(text) {
    if line.has_prefix("NATIVE_ASYNC_RESULT ") {
      if found is Some(_) {
        fail("duplicate NATIVE_ASYNC_RESULT")
      }
      found = Some(
        @json.parse(line[20:].to_owned()) catch {
          _ => raise ProbeFailure("malformed NATIVE_ASYNC_RESULT JSON")
        },
      )
    }
  }
  match found {
    Some(Json::Object(values)) => {
      require_json_true(values, "ok")
      require_json_true(values, "responsive")
      require_json_int(values, "rejected", 3L)
      require_json_int(values, "stage", 6L)
      require_json_int(values, "scene_x", 90L)
      require_json_int(values, "status", 5L)
      require_json_int(values, "pending", 0L)
      require_json_int(values, "active", 0L)
      require_json_true(values, "closed")
      require_json_string(values, "adapter")
      require_json_min_int(values, "frames", 4L)
      require_json_min_int(values, "io_wakes", 1L)
      require_json_min_int(values, "io_proxies", 1L)
      require_json_min_int(values, "io_indefinite", 1L)
      require_json_true(values, "hwnd_destroyed")
      require_json_true(values, "message_hwnd_destroyed")
      match values.get("original_error") {
        Some(Json::Null) => ()
        _ => fail("invalid original_error field")
      }
    }
    Some(_) => fail("NATIVE_ASYNC_RESULT is not an object")
    None => fail("missing NATIVE_ASYNC_RESULT")
  }
}

///|
async fn run_probe(
  root : String,
  kind : String,
  mode : String,
  case_name : String,
) -> Unit raise Error {
  let fallback = if mode == "fallback" { "1" } else { "0" }
  let raw_surface = kind == "surface" &&
    @env.get_env_var("METONIC_SURFACE_RAW") == Some("1")
  let fresh_surface = kind == "surface" &&
    (!raw_surface || @env.get_env_var("METONIC_SURFACE_FRESH") == Some("1"))
  let executable = if kind == "async" {
    root +
    "/.work/native-host-build/native/debug/build/local/native_host/async_app/async_app.exe"
  } else if kind == "surface" {
    root +
    "/_build/native/release/build/tools/native_surface_probe/native_surface_probe.exe"
  } else {
    root +
    "/.work/native-host-build/native/debug/build/local/native_host/window_probe/window_probe.exe"
  }
  let bridge = if kind == "window" || kind == "surface" {
    root + "/.work/native-cargo/missing-surface-bridge.dll"
  } else {
    root + "/.work/native-cargo/missing-native-surface.dll"
  }
  let output_dir = root + "/.work/native-" + kind
  if !@fs.exists(output_dir) {
    @fs.mkdir(output_dir, recursive=true)
  }
  let started = @async.now()
  let stdout_state : Ref[StreamState] = {
    val: { bytes: [], overflow: false, },
  }
  let stderr_state : Ref[StreamState] = {
    val: { bytes: [], overflow: false, },
  }
  let mut exit_code : Int? = None
  let mut timed_out = false
  let mut original_error : Error? = None
  try {
    exit_code = Some(
      @async.with_timeout(20000, async fn() {
        @async.with_task_group() <| group => {
          let (stdout_reader, stdout_output) = @process.read_from_process()
          let (stderr_reader, stderr_output) = @process.read_from_process()
          group.add_defer(fn() {
            stdout_reader.close()
            stderr_reader.close()
          })
          let env_map : Map[String, String] = Map([])
          env_map.set("METONIC_GPU_BRIDGE", bridge)
          env_map.set("METONIC_WINDOW_TEST", "1")
          env_map.set("METONIC_WINDOW_INIT_TEST", case_name)
          env_map.set("METONIC_GPU_FALLBACK", fallback)
          let received = Ref(0)
          let mut query_server_task : @async.Task[Unit]? = None
          let query_case = case_name == "query" || case_name == "query-latin"
          if query_case {
            let server = @http.Server(@socket.Addr::parse("127.0.0.1:0"))
            group.add_defer(fn() { server.close() })
            env_map.set("METONIC_RPC_BASE", "http://" + server.addr.to_string())
            query_server_task = Some(
              group.spawn(() => {
                server.run_forever((request, body, conn) => {
                  defer conn.close()
                  assert_eq(request.meth, @http.Post)
                  assert_eq(request.path, "/rpc")
                  let bytes : Array[Byte] = []
                  while body.read_some(max_len=4097 - bytes.length())
                        is Some(chunk) {
                    for byte in chunk {
                      bytes.push(byte)
                    }
                    require(
                      bytes.length() <= 4096,
                      "query request exceeds fixture limit",
                    )
                  }
                  let expected_id = if case_name == "query" {
                    "日本語日本語 日本語日本語 日本語日本語 日本語日本語"
                  } else {
                    "abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij"
                  }
                  let expected : Json = {
                    "version": 1,
                    "procedure": "users.get.v1",
                    "input": { "id": expected_id },
                  }
                  assert_eq(
                    @json.parse(@utf8.decode(Bytes::from_array(bytes))),
                    expected,
                  )
                  received.val += 1
                  let headers : Map[@http.CaseInsensitiveString, String] = Map([])
                  headers.set(
                    @http.CaseInsensitiveString("Content-Type"),
                    "application/json",
                  )
                  headers.set(
                    @http.CaseInsensitiveString("Connection"),
                    "close",
                  )
                  conn.send_response(200, "", extra_headers=headers)
                  conn.write_string(
                    "{\"version\":1,\"ok\":false,\"error\":{\"kind\":\"domain\",\"code\":\"not_found\"}}",
                  )
                  conn.end_response()
                })
              }),
            )
          }
          if kind == "async" {
            let input = @env.get_env_var("METONIC_ASYNC_INPUT").unwrap_or(
              root.replace_all(old="\\", new="/") +
              "/experiments/window_async_contract/input.txt",
            )
            env_map.set("METONIC_ASYNC_INPUT", input)
          }
          let child = @process.spawn(
            group,
            executable,
            [],
            extra_env=env_map,
            stdout=stdout_output,
            stderr=stderr_output,
            no_console_window=true,
            no_wait=true,
            cancel_handler=@process.hard_cancel(),
          )
          group.add_defer(fn() { child.cancel() })
          group.spawn_bg() <| () => {
            drain(stdout_reader, stdout_state, child)
          }
          group.spawn_bg() <| () => {
            drain(stderr_reader, stderr_state, child)
          }
          let code = child.wait()
          if query_server_task is Some(task) {
            task.cancel()
            task.wait() catch {
              error if @async.is_cancellation_error(error) => ()
              error => raise error
            }
          }
          if query_case && code == 0 {
            assert_eq(received.val, 1)
          }
          code
        }
      }),
    )
  } catch {
    @async.TimeoutError as error => {
      timed_out = true
      original_error = Some(error)
    }
    error => original_error = Some(error)
  }
  let stdout = @utf8.decode_lossy(Bytes::from_array(stdout_state.val.bytes))
  let stderr = @utf8.decode_lossy(Bytes::from_array(stderr_state.val.bytes))
  let elapsed = (@async.now() - started).to_int()
  let shutdown = if kind == "async" { shutdown_ms(stdout) } else { None }
  let shutdown_json = match shutdown {
    Some(value) => Json::number(value.to_double())
    None => json_null()
  }
  let report = Json::object({
    "exit": match exit_code {
      Some(value) => Json::number(value.to_double())
      None => json_null()
    },
    "stdout": Json::string(stdout),
    "stderr": Json::string(stderr),
    "timedOut": Json::boolean(timed_out),
    "error": match original_error {
      Some(value) => Json::string(@debug.to_string(value))
      None => json_null()
    },
    "signal": json_null(),
    "overflow": Json::boolean(
      stdout_state.val.overflow || stderr_state.val.overflow,
    ),
    "elapsedMs": Json::number(elapsed.to_double()),
    "mode": Json::string(mode),
    "initCase": Json::string(case_name),
    "scope": Json::string(
      if kind == "surface" {
        if raw_surface {
          "raw clear/present across device replacement; no renderer, resize or input coverage"
        } else {
          "hidden surface initial, resize, and three fresh renderer generations with close checks; not visible UI or desktop automation"
        }
      } else if kind == "window" {
        if case_name == "input" {
          "MoonBit surface renderer input initialization and own-window dispatch; hidden input path only"
        } else if case_name == "close" {
          "MoonBit surface renderer close initialization and own-window dispatch; hidden close path only"
        } else {
          "MoonBit surface renderer with own-window message dispatch; not visible UI, IME, accessibility or desktop automation"
        }
      } else if kind == "async" {
        "async library real file I/O with hidden owned-HWND synthetic key/close"
      } else {
        "worker completion through hidden HWND; not network, visible input, IME or general closure FFI"
      },
    ),
    "shutdownMs": shutdown_json,
    "rawSurface": Json::boolean(raw_surface),
    "freshSurface": Json::boolean(fresh_surface),
  })
  @async.protect_from_cancel() <| () => {
    let filename = if case_name == "normal" {
      mode
    } else {
      mode + "-" + case_name
    }
    @fs.write_file(output_dir + "/" + filename + ".json", report.stringify()) catch {
      error =>
        match original_error {
          Some(_) =>
            println("probe report write failed: " + @debug.to_string(error))
          None => raise error
        }
    }
  }
  match original_error {
    Some(error) => raise error
    None => ()
  }
  require(
    !stdout_state.val.overflow && !stderr_state.val.overflow,
    kind + " output overflow",
  )
  if kind == "window" {
    require(
      exact_line_count(stdout, "WINDOW_CLEANUP_OK") == 1,
      "window cleanup marker missing or duplicated",
    )
  }
  if kind == "window" && (case_name == "input" || case_name == "close") {
    let retained = marker_number(stdout, "WINDOW_INIT_RETAINED=")
    let remaining = marker_number(stdout, "WINDOW_INIT_REMAINING=")
    require(retained is Some(value) && value > 0, "window retained marker")
    require(remaining == Some(0), "window remaining marker")
  }
  require(exit_code == Some(0), kind + " exit")
  require(!stdout.contains("FAILED"), kind + " FAILED marker")
  require(
    exact_line(
      stdout,
      if kind == "surface" {
        if raw_surface {
          "RAW_SURFACE_OK"
        } else {
          "SURFACE_RENDERER_OK"
        }
      } else if kind == "window" {
        if case_name == "input" {
          "WINDOW_INIT_INPUT_OK"
        } else if case_name == "close" {
          "WINDOW_INIT_CLOSE_OK"
        } else if case_name == "capture" {
          "WINDOW_CAPTURE_OBSERVATION_OK"
        } else if case_name == "query" || case_name == "query-latin" {
          "WINDOW_QUERY_SCROLL_OK"
        } else {
          "WINDOW_PROBE_OK"
        }
      } else {
        "NATIVE_ASYNC_OK"
      },
    ),
    kind + " success marker",
  )
  if kind == "async" {
    require(
      exact_line_count(stdout, "NATIVE_ASYNC_OK") == 1,
      "async success marker count",
    )
  }
  if kind == "async" {
    match shutdown {
      Some(value) =>
        require(value >= 0 && value < 1000, "async shutdown timing")
      None => fail("async shutdown timing missing or duplicated")
    }
    require_native_async_result(stdout)
  }
}

///|
async fn main {
  require(marker_number("X=1\n", "X=") == Some(1), "marker parser valid")
  require(marker_number("X=0\n", "X=") == Some(0), "marker parser zero")
  require(marker_number("", "X=") is None, "marker parser missing")
  require(marker_number("X=1\nX=2\n", "X=") is None, "marker parser duplicate")
  require(marker_number("X=\n", "X=") is None, "marker parser empty")
  require(marker_number("X=a\n", "X=") is None, "marker parser nondigit")
  require(
    marker_number("X=2147483648\n", "X=") is None,
    "marker parser overflow",
  )
  require(
    marker_number("X=21474836480\n", "X=") is None,
    "marker parser long overflow",
  )
  require(
    marker_number("X=4294967296\n", "X=") is None,
    "marker parser wrapped overflow",
  )
  let root = @fs.realpath(".")
  let selected = @env.get_env_var("METONIC_NATIVE_PROBE")
  let kinds = match selected {
    None => ["window", "async"]
    Some(value) if value == "window" => ["window"]
    Some(value) if value == "async" => ["async"]
    Some(value) if value == "surface" => ["surface"]
    Some(_) => abort("METONIC_NATIVE_PROBE must be window, async, or surface")
  }
  let modes = if @env.get_env_var("METONIC_GPU_FALLBACK") == Some("1") {
    ["fallback"]
  } else {
    ["default", "fallback"]
  }
  for kind in kinds {
    for mode in modes {
      let cases = if kind == "window" {
        ["normal", "input", "close", "capture", "query", "query-latin"]
      } else {
        ["normal"]
      }
      for case_name in cases {
        run_probe(root, kind, mode, case_name) catch {
          error => {
            println(@debug.to_string(error))
            abort(@debug.to_string(error))
          }
        }
      }
    }
  }
}

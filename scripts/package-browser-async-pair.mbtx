import {
  "moonbitlang/async@0.21.2",
  "moonbitlang/async@0.21.2/fs",
}

///|
async fn main {
  let destination = ".work/browser-async-pair"
  if !@fs.exists(destination) {
    @fs.mkdir(destination, recursive=true)
  }
  let entries = [
    ("examples/async_pair/browser/index.html", "index.html"),
    ("examples/async_pair/browser/host.mjs", "async-pair-host.mjs"),
    (
      "browser_host/_build/js/release/build/local/browser_host/async_pair/async_pair.js",
      "async-pair.mjs",
    ),
    (
      "browser_host/_build/wasm-gc/release/build/local/browser_host/async_pair/async_pair.wasm",
      "async-pair.wasm",
    ),
    ("browser_host/runtime/surface.mjs", "surface.mjs"),
    ("browser_host/runtime/application.mjs", "application.mjs"),
    ("browser_host/runtime/layer-renderer.mjs", "layer-renderer.mjs"),
    ("browser_host/runtime/wasm-imports.mjs", "wasm-imports.mjs"),
    (".work/browser-dist/browser-buffer.mjs", "browser-buffer.mjs"),
    (".work/browser-dist/websys-input.mjs", "websys-input.mjs"),
    (".work/browser-dist/NotoSansJP.ttf", "NotoSansJP.ttf"),
    (".work/browser-dist/OFL.txt", "OFL.txt"),
    (".work/browser-dist/LICENSE-websys", "LICENSE-websys"),
    (".work/browser-dist/LICENSE-async", "LICENSE-async"),
    ("LICENSE-MIT", "LICENSE-MIT"),
    ("LICENSE-APACHE", "LICENSE-APACHE"),
  ]
  for name in @fs.readdir(destination) {
    assert_true(
      entries.any(entry => entry.1 == name),
      msg="unexpected async-pair artifact: " + name,
    )
  }
  for (source, name) in entries {
    let data = @fs.read_file(source)
    if name.has_suffix(".mjs") || name.has_suffix(".html") {
      for
        forbidden in [
          "metonicAsyncProbe", "metonicInputTrace", "environment-dev",
        ] {
        assert_false(
          data.text().contains(forbidden),
          msg="development code in async-pair artifact " +
            name +
            ": " +
            forbidden,
        )
      }
    }
    @fs.write_file(destination + "/" + name, data.binary())
  }
  println("BROWSER_ASYNC_PAIR_PACKAGED")
}

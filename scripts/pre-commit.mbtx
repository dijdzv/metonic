import {
  "moonbitlang/async@0.21.2",
  "moonbitlang/async@0.21.2/fs",
  "moonbitlang/async@0.21.2/process",
  "moonbitlang/core/json",
  "moonbitlang/core/env",
}

///|
fn fail(message : String) -> Unit {
  println(message)
  abort(message)
}

///|
let gpu_env : Map[String, String] = Map([
  ("METONIC_GPU_FALLBACK", "1"),
  ("METONIC_GPU_BACKEND", "swiftshader"),
  // Keep diagnostic raw-surface mode out of normal pre-commit gates.
  ("METONIC_SURFACE_RAW", "0"),
])

///|
async fn run(cmd : String, args : Array[String]) -> Unit {
  println("pre-commit: " + cmd + " " + args.join(" "))
  let started = @async.now()
  let code = @process.run(cmd, args, extra_env=gpu_env, no_console_window=true)
  let timing : Json = {
    "command": cmd,
    "args": args,
    "elapsed_ms": (@async.now() - started).to_int(),
    "exit_code": code,
  }
  println("pre-commit timing: " + timing.stringify())
  if code != 0 {
    fail("command failed (" + code.to_string() + "): " + cmd)
  }
  println("HOOK_CHECK_OK: " + args.join(" "))
}

///|
async fn expect_clean(args : Array[String], label : String) -> Unit {
  let (code, _stdout, _stderr) = @process.collect_output(
    "git",
    args,
    no_console_window=true,
  )
  if code != 0 {
    fail(label)
  }
}

///|
async fn reactive_contracts_changed() -> Bool {
  let (code, output, _) = @process.collect_output(
    "git",
    ["diff", "--cached", "--name-only", "HEAD", "--"],
    no_console_window=true,
  )
  assert_eq(code, 0)
  for path in output.text().split("\n") {
    if path.has_prefix("core/reactive/") ||
      path.has_prefix("tools/reactive_negative/") ||
      path == "scripts/verify-reactive-negative.mbtx" ||
      path == "scripts/pre-commit.mbtx" ||
      path == "toolchain.json" ||
      path == "moon.mod" ||
      path == "moon.lock" {
      return true
    }
  }
  false
}

///|
async fn main {
  let started = @async.now()
  let ime_manifest = ".work/native-deps/sources/window-pointer-capture/modules/window/windows/moon.pkg"
  let initial_ime_manifest = if @fs.exists(ime_manifest) {
    Some(@fs.read_file(ime_manifest).text())
  } else {
    None
  }
  // Keep dependency bytes identical across recorded verification without
  // rewriting them between every build inside the gate. Unknown changes must
  // fail validation rather than being hidden by restoring the entry state.
  defer @async.protect_from_cancel(() => {
    if initial_ime_manifest is Some(initial) {
      if @fs.read_file(ime_manifest).text() != initial {
        let code = @process.run(
          ".tools/moonbit/bin/moon.exe",
          ["run", "scripts/prepare-native-deps.mbtx", "--", "--offline"],
          no_console_window=true,
        )
        assert_eq(
          code,
          0,
          msg="cannot restore an unvalidated IME configuration",
        )
        @fs.write_file(ime_manifest, initial)
      }
    }
  })
  let args = @env.args()
  let integration_only = args.length() == 2 && args[1] == "--integration"
  let commit_only = args.length() == 2 && args[1] == "--commit"
  let push_only = args.length() == 3 && args[1] == "--push"
  assert_true(
    args.length() == 1 || integration_only || commit_only || push_only,
    msg="usage: pre-commit [--integration | --commit | --push base-commit]",
  )
  let push_base = if push_only {
    let (code, output, _) = @process.collect_output(
      "git",
      ["rev-parse", "--verify", "--end-of-options", args[2] + "^{commit}"],
      no_console_window=true,
    )
    assert_eq(
      code,
      0,
      msg="push lane requires the commit lane's comparison commit",
    )
    let base = output.text().trim().to_owned()
    assert_false(base.is_empty() || base.contains("\n"))
    Some(base)
  } else {
    None
  }
  let moon = ".tools/moonbit/bin/moon.exe"
  if !integration_only && !push_only {
    expect_clean(["diff", "--quiet"], "unstaged changes detected")
    run("git", ["diff", "--cached", "--check"])
    run(moon, ["run", "scripts/prepare-wgpu.mbtx"])
    run(moon, ["run", "scripts/prepare-websys-input.mbtx"])
    run(moon, ["run", "scripts/prepare-browser-dev.mbtx"])
    run(moon, ["fmt"])
    run(moon, ["run", "scripts/format-scripts.mbtx"])
    run(moon, ["-C", "experiments/wgpu_binding", "fmt"])
    run(moon, ["-C", "browser_host", "fmt", "app"])
    run(moon, ["-C", "browser_host", "fmt", "../async_runtime/clock"])
    run(moon, ["-C", "browser_host", "fmt", "../async_runtime/http"])
    run(moon, ["-C", "browser_host", "fmt", "../async_runtime/application_task"])
    expect_clean(
      ["diff", "--exit-code"],
      "formatting changed files; review and stage explicitly",
    )
    run(moon, ["check", "--target", "js", "--deny-warn"])
    run(moon, ["check", "--target", "wasm-gc", "--deny-warn"])
    run(moon, [
      "test", "tools/verification_impact_cli", "--target", "wasm", "--deny-warn",
    ])
    run(moon, ["run", "scripts/verify-application-build-inputs.mbtx"])
  }
  if commit_only {
    run(moon, [
      "-C", "browser_host", "test", "../async_runtime/http", "../async_runtime/application_task",
      "--target", "js", "--deny-warn",
    ])
    run(moon, [
      "-C", "browser_host", "test", "../async_runtime/clock", "--target", "js", "--deny-warn",
    ])
    run(moon, ["run", "scripts/verify.mbtx", "--", "--native-workspace"])
    for target in ["js", "wasm-gc"] {
      run(moon, [
        "-C", "browser_host", "check", "--target", target, "--deny-warn",
      ])
    }
    for target in ["js", "wasm-gc", "wasm", "native"] {
      run(moon, [
        "run", "scripts/plan-local-verification.mbtx", "--", target, "--run-commit",
      ])
    }
    for target in ["js", "wasm-gc", "native"] {
      run(moon, [
        "run", "scripts/verify.mbtx", "--", "--target-contracts", target,
      ])
    }
    if reactive_contracts_changed() {
      run(moon, ["run", "scripts/verify-reactive-negative.mbtx"])
    }
    run(moon, ["run", "scripts/verify-docs.mbtx"])
    println(
      "pre-commit total_ms: " + (@async.now() - started).to_int().to_string(),
    )
    return
  }
  if push_base is Some(base) {
    for target in ["js", "wasm-gc", "wasm", "native"] {
      run(moon, [
        "run", "scripts/plan-local-verification.mbtx", "--", target, "--run-remainder",
        base,
      ])
    }
  }
  let policy : Map[String, Json] = @json.from_json(
    @json.parse(@fs.read_file("verification.json").text()),
  )
  assert_eq(policy.get("version"), Some(Json::number(1)))
  let gates : Array[String] = @json.from_json(
    policy.get("full_gate_tasks").unwrap(),
  )
  assert_false(gates.is_empty())
  let seen : Map[String, Bool] = Map([])
  for gate in gates {
    assert_false(gate.is_empty() || gate.has_prefix("-") || seen.contains(gate))
    seen[gate] = true
  }
  for gate in gates {
    if (integration_only || push_only) &&
      (gate == "verify" || gate == "verify-native") {
      continue
    }
    println("pre-commit gate: mise run " + gate)
    run("mise", ["run", gate])
  }
  run(moon, ["run", "scripts/verify-window-fixture-exclusion.mbtx"])
  run(moon, ["run", "scripts/verify-window-production-exclusion.mbtx"])
  if !integration_only && !push_only {
    println("pre-commit gate: docs")
    run(moon, ["run", "scripts/verify-docs.mbtx"])
  }
  println(
    "pre-commit total_ms: " + (@async.now() - started).to_int().to_string(),
  )
}

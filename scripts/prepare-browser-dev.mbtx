import {
  "moonbitlang/async@0.21.2",
  "moonbitlang/async@0.21.2/fs",
}

///|
async fn main {
  let source = "browser_host/app"
  let destination = ".work/browser-host-dev"
  if !@fs.exists(destination) {
    @fs.mkdir(destination, recursive=true)
  }
  let names : Array[String] = []
  for name in @fs.readdir(source) {
    if name.has_suffix(".mbt") || name == "moon.pkg" || name == "moon.mod" {
      names.push(name)
      let content = @fs.read_file(source + "/" + name).text()
      @fs.write_file(
        destination + "/" + name,
        if name == "moon.mod" {
          content
          .replace_all(old="local/browser_host", new="local/browser_host_dev")
          .replace_all(
            old="import {",
            new="import {\n  \"local/browser_host@0.0.0\",",
          )
        } else {
          content
        },
      )
    }
  }
  names.push("observe.mbt")
  @fs.write_file(
    destination + "/observe.mbt",
    @fs.read_file("browser_host/development/observe.mbt").binary(),
  )
  // This directory owns generated source copies; stale .mbt files must not keep
  // removed implementations alive after an upgrade. Reject other unknown files.
  let resolved = @fs.realpath(destination).replace_all(old="\\", new="/")
  for name in @fs.readdir(destination) {
    if !names.contains(name) {
      assert_true(
        name.has_suffix(".mbt"),
        msg="unexpected development file: " + name,
      )
      let path = resolved + "/" + name
      assert_eq(@fs.realpath(path).replace_all(old="\\", new="/"), path)
      @fs.remove(path)
    }
  }
  println("BROWSER_DEVELOPMENT_SOURCES_READY")
}

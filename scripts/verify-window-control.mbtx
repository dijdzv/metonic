import {
  "moonbitlang/async@0.21.2",
  "moonbitlang/async@0.21.2/fs",
  "moonbitlang/async@0.21.2/process",
  "moonbitlang/core/json",
}

///|
struct Reply {
  id : Json
  error : String
  text : String?
  frames : Int?
  task_status : Int?
} derive(FromJson)

///|
async fn verify_case(fallback : Bool) -> Unit {
  let initial = "日本語の描画を確認します ABC 123"
  let mut oversized = ""
  for _ in 0..<4200 {
    oversized += "x"
  }
  let requests = "{\"id\":1,\"op\":\"snapshot\"}\n{\"id\":2,\"op\":\"insert\",\"text\":\"日本\"}\n{\"id\":3,\"op\":\"backspace\"}\n{\"id\":4,\"op\":\"start_update\"}\n{\"id\":5,\"op\":\"cancel_update\"}\ninvalid\n" +
    oversized +
    "\n{\"id\":6,\"op\":\"snapshot\"}"
  let requests = requests +
    "\n{\"id\":6,\"op\":\"insert\",\"text\":\"wrong\"}\n{\"id\":7,\"op\":\"insert\",\"text\":\"wrong\",\"expected_semantic_revision\":1}\n{\"id\":8,\"op\":\"insert\",\"text\":\"Z\",\"expected_semantic_revision\":7}"
  @fs.write_file(".work/window-control-input.jsonl", requests)
  let env : Map[String, String] = Map([])
  env.set("METONIC_DEV_HIDDEN", "1")
  env.set("METONIC_WINDOW_TEST", "0")
  env.set("METONIC_GPU_FALLBACK", if fallback { "1" } else { "0" })
  let input = @process.redirect_from_file(".work/window-control-input.jsonl")
  let (code, out, err) = @async.with_timeout(20000, () => {
    @process.collect_output(
      ".work/native-host-build/native/debug/build/local/native_host/window_dev/window_dev.exe",
      [],
      extra_env=env,
      stdin=input,
      no_console_window=true,
    )
  })
  let tag = if fallback { "fallback" } else { "default" }
  @fs.write_file(".work/window-control-" + tag + "-output.jsonl", out.text())
  @fs.write_file(".work/window-control-" + tag + "-error.log", err.text())
  assert_eq(code, 0)
  let rows = out.text().trim().split("\n").to_array()
  assert_eq(rows.length(), 11)
  for index in [0, 1, 2, 3, 4, 7, 8, 9, 10] {
    let value = @json.parse(rows[index].to_owned())
    guard value is Object(fields) else { fail("snapshot is not an object") }
    guard fields.get("ime_events") is Some(Array(events)) else {
      fail("snapshot omitted IME history")
    }
    assert_true(events.length() <= 128)
    guard fields.get("raw_ime_events") is Some(Array(raw_events)) else {
      fail("snapshot omitted raw IME history")
    }
    assert_true(raw_events.length() <= 128)
    assert_eq(fields.get("ime_dropped"), Some(0L.to_json()))
  }
  let replies : Array[Reply] = rows.map(row => {
    @json.from_json(@json.parse(row.to_owned()))
  })
  assert_eq(replies[0].text, Some(initial))
  assert_eq(replies[1].text, Some(initial + "日本"))
  assert_eq(replies[2].text, Some(initial + "日"))
  assert_true(replies[1].frames.unwrap() > replies[0].frames.unwrap())
  assert_eq(replies[3].task_status, Some(1))
  assert_eq(replies[4].task_status, Some(4))
  assert_eq(replies[5].error, "invalid_request")
  assert_eq(replies[6].error, "line_too_long")
  assert_eq(replies[7].id, Json::number(6))
  assert_eq(replies[7].text, Some(initial + "日"))
  assert_eq(replies[8].error, "duplicate_id")
  assert_eq(replies[8].text, Some(initial + "日"))
  assert_eq(replies[9].error, "stale_revision")
  assert_eq(replies[9].text, Some(initial + "日"))
  assert_eq(replies[10].error, "")
  assert_eq(replies[10].text, Some(initial + "日Z"))
  for index in [0, 1, 2, 3, 4, 7] {
    assert_eq(replies[index].error, "")
  }
  println("WINDOW_CONTROL_OK")
}

///|
async fn main {
  verify_case(false)
  verify_case(true)
  verify_window_close(false)
  verify_window_close(true)
  verify_window_close(false, pending=true)
  verify_window_close(true, pending=true)
}

///|
async fn verify_window_close(fallback : Bool, pending? : Bool = false) -> Unit {
  @async.with_timeout(20000, async fn() {
    @async.with_task_group() <| group => {
      let (stdin, writer) = @process.write_to_process()
      defer writer.close()
      let (reader, stdout) = @process.read_from_process()
      defer reader.close()
      let ui = @process.spawn(
        group,
        ".work/native-host-build/native/debug/build/local/native_host/window_dev/window_dev.exe",
        [],
        stdin~,
        stdout~,
        no_console_window=true,
        extra_env=Map([
          ("METONIC_DEV_HIDDEN", "0"),
          ("METONIC_GPU_FALLBACK", if fallback { "1" } else { "0" }),
        ]),
      )
      writer.write("{\"id\":1,\"op\":\"snapshot\"}\n")
      let ready : Reply = @json.from_json(
        @json.parse(reader.read_until("\n").unwrap()),
      )
      assert_eq(ready.error, "")
      if pending {
        writer.write("{\"id\":2,\"op\":\"capture\"}\n")
        assert_eq(reader.read_some(max_len=1).unwrap(), b"{")
        writer.write("{\"id\":3,\"op\":\"insert\",\"text\":\"queued\"}\n")
      }
      let closer = @process.spawn(
        group,
        ".work/native-host-build/native/debug/build/local/native_host/accessibility_probe/accessibility_probe.exe",
        [ui.pid.to_string(), "close-only"],
        no_console_window=true,
      )
      assert_eq(closer.wait(), 0)
      assert_eq(@async.with_timeout(2000, () => ui.wait()), 0)
      if pending {
        let tail = reader.read_until("\n").unwrap()
        let incomplete = try {
          ignore(@json.parse("{" + tail))
          false
        } catch {
          _ => true
        }
        assert_true(incomplete, msg="capture response completed before close")
      }
      assert_eq(reader.read_until("\n"), None)
      let rejected = try {
        writer.write("{\"id\":2,\"op\":\"insert\",\"text\":\"late\"}\n")
        false
      } catch {
        _ => true
      }
      assert_true(rejected)
      println(
        "WINDOW_CONTROL_CLOSE_OK stdin_open late_write_rejected fallback=" +
        fallback.to_string(),
      )
      if pending {
        println(
          "WINDOW_CONTROL_PENDING_CLOSE_OK truncated_response queued_request",
        )
      }
    }
  })
}

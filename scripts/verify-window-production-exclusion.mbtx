import {
  "moonbitlang/async@0.21.2",
  "moonbitlang/async@0.21.2/fs",
  "moonbitlang/core/encoding/utf8",
}

///|
async fn main {
  let root = ".work/native-host-build/native/"
  let production = @fs.read_file(
    root + "release/build/local/native_host/window_app/window_app.c",
  ).text()
  let development = @fs.read_file(
    root + "debug/build/local/native_host/window_dev/window_dev.c",
  ).text()
  let ime_probe = @fs.read_file(
    root + "debug/build/local/native_host/window_probe/window_probe.c",
  ).text()
  assert_true(ime_probe.contains("mbw_ime_trace_probe_cursor"))
  assert_false(development.contains("mbw_ime_trace_probe_cursor"))
  assert_false(production.contains("mbw_ime_trace_probe_cursor"))
  for
    marker in [
      "App_3a_3ahandle", "capture__frame", "Captured", "InputObservation", "ime__events",
      "ime__dropped", "mbw_ime_trace_get",
    ] {
    guard development.contains(marker) else {
      abort("development positive control missing: " + marker)
    }
    guard !production.contains(marker) else {
      abort("production retains development code: " + marker)
    }
  }
  let mailbox_probe = @fs.read_file(
    root + "debug/build/local/native_host/mailbox_probe/mailbox_probe.c",
  ).text()
  guard mailbox_probe.contains("metonic_mailbox_probe_") else {
    abort("mailbox fixture positive control missing")
  }
  let sdk_probe = @fs.read_file(
    root + "debug/build/local/native_host/sdk_mailbox_probe/sdk_mailbox_probe.c",
  ).text()
  guard sdk_probe.contains("metonic_sdk_") else {
    abort("SDK mailbox fixture positive control missing")
  }
  for
    marker in [
      "Observation", "window_probe", "window_dev", "metonic_mailbox_probe_", "metonic_sdk_",
    ] {
    guard !production.contains(marker) else {
      abort("production retains development type or package: " + marker)
    }
  }
  let link = @fs.read_file(
    root + "release/build/local/native_host/window_app/window_app.c.rsp",
  ).text()
  guard link.contains("window_app") else {
    abort("production link input missing")
  }
  for
    dependency in [
      "window_probe", "window_dev", "native_session", "native_control", "mailbox_probe",
      "sdk_mailbox_probe", "named_pipe", "pipe_test_support",
    ] {
    guard !link.contains(dependency) else {
      abort("production links development package: " + dependency)
    }
  }
  let release_binary = @utf8.decode_lossy(
    @fs.read_file(
      root + "release/build/local/native_host/window_app/window_app.exe",
    ).binary(),
  )
  let dev_binary = @utf8.decode_lossy(
    @fs.read_file(
      root + "debug/build/local/native_host/window_dev/window_dev.exe",
    ).binary(),
  )
  for
    marker in [
      "moonbitlang_async_create_private_duplex_pipe", "moonbitlang_async_connect_pipe",
      "moonbitlang_async_make_pipe_connect_io_result", "moonbitlang_async_disconnect_pipe_checked",
    ] {
    guard dev_binary.contains(marker) else {
      abort("development pipe positive control missing: " + marker)
    }
    guard !release_binary.contains(marker) else {
      println("production retains pipe FFI export: " + marker)
      abort("production retains pipe FFI export")
    }
  }
  for profile in ["debug", "release"] {
    let object = @utf8.decode_lossy(
      @fs.read_file(
        root + profile + "/build/wzzc-dev/window/windows/native_window.obj",
      ).binary(),
    )
    assert_eq(object.contains("mbw_ime_trace_get"), profile == "debug")
    assert_false(object.contains("mbw_ime_trace_probe_cursor"))
  }
  println(
    "WINDOW_PRODUCTION_EXCLUSION_OK generated_c_link_inputs_binary_and_ime_object",
  )
}

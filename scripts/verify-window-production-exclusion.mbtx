import {
  "moonbitlang/async@0.21.2",
  "moonbitlang/async@0.21.2/fs",
}

///|
async fn main {
  let root = ".work/native-host-build/native/"
  let production = @fs.read_file(
    root + "release/build/local/native_host/window_app/window_app.c",
  ).text()
  let development = @fs.read_file(
    root + "debug/build/local/native_host/window_dev/window_dev.c",
  ).text()
  for
    marker in [
      "App_3a_3ahandle", "capture__frame", "Captured", "InputObservation",
    ] {
    guard development.contains(marker) else {
      abort("development positive control missing: " + marker)
    }
    guard !production.contains(marker) else {
      abort("production retains development code: " + marker)
    }
  }
  let mailbox_probe = @fs.read_file(
    root + "debug/build/local/native_host/mailbox_probe/mailbox_probe.c",
  ).text()
  guard mailbox_probe.contains("metonic_mailbox_probe_") else {
    abort("mailbox fixture positive control missing")
  }
  let sdk_probe = @fs.read_file(
    root + "debug/build/local/native_host/sdk_mailbox_probe/sdk_mailbox_probe.c",
  ).text()
  guard sdk_probe.contains("metonic_sdk_") else {
    abort("SDK mailbox fixture positive control missing")
  }
  for
    marker in [
      "Observation", "window_probe", "window_dev", "metonic_mailbox_probe_", "metonic_sdk_",
    ] {
    guard !production.contains(marker) else {
      abort("production retains development type or package: " + marker)
    }
  }
  let link = @fs.read_file(
    root + "release/build/local/native_host/window_app/window_app.c.rsp",
  ).text()
  guard link.contains("window_app") else {
    abort("production link input missing")
  }
  for
    dependency in [
      "window_probe", "window_dev", "native_session", "native_control", "mailbox_probe",
      "sdk_mailbox_probe",
    ] {
    guard !link.contains(dependency) else {
      abort("production links development package: " + dependency)
    }
  }
  println("WINDOW_PRODUCTION_EXCLUSION_OK generated_c_and_link_inputs")
}

import {
  "moonbitlang/async@0.21.2",
  "moonbitlang/async@0.21.2/fs",
  "moonbitlang/async@0.21.2/process",
  "moonbitlang/core/encoding/utf8",
}

///|
fn fail(message : String) -> Unit {
  println(message)
  abort(message)
}

///|
async fn main {
  let moon = @fs.realpath(".tools/moonbit/bin/moon.exe")
  assert_eq(
    @process.run(
      moon,
      ["run", "scripts/prepare-browser-dev.mbtx"],
      no_console_window=true,
    ),
    0,
  )
  assert_eq(
    @process.run(
      moon,
      ["run", "scripts/prepare-websys-input.mbtx"],
      no_console_window=true,
    ),
    0,
  )
  let server_code = @process.run(
    moon,
    [
      "build", "tools/browser_server", "--target", "wasm", "--release", "--deny-warn",
    ],
    no_console_window=true,
  )
  if server_code != 0 {
    fail("browser server wasm build failed")
  }
  assert_eq(
    @process.run(
      moon,
      [
        "build", "tools/browser_buffer", "--target", "js", "--release", "--deny-warn",
      ],
      no_console_window=true,
    ),
    0,
  )
  let (js_code, js_out, js_err) = @process.collect_output(
    moon,
    [
      "-C", "browser_host", "build", "app", "../.work/browser-host-dev", "--target",
      "js", "--release", "--deny-warn",
    ],
    no_console_window=true,
  )
  println(js_out.text())
  println(js_err.text())
  if js_code != 0 {
    fail("JavaScript build failed")
  }
  let (wasm_code, wasm_out, wasm_err) = @process.collect_output(
    moon,
    [
      "-C", "browser_host", "build", "app", "../.work/browser-host-dev", "--target",
      "wasm-gc", "--release", "--deny-warn",
    ],
    no_console_window=true,
  )
  println(wasm_out.text())
  println(wasm_err.text())
  if wasm_code != 0 {
    fail("WasmGC build failed")
  }
  for target in ["js", "wasm-gc"] {
    assert_eq(
      @process.run(
        moon,
        [
          "-C", "browser_host", "build", "app/probe", "app/notes", "app/gpu_probe",
          "app/application_probe", "app/async_pair", "--target", target, "--release",
          "--deny-warn",
        ],
        no_console_window=true,
      ),
      0,
    )
  }
  for
    host in [
      "host.mjs", "loader.mjs", "loader-common.mjs", "loader-release.mjs", "environment-dev.mjs",
      "environment-release.mjs", "text-renderer.mjs",
    ] {
    let (check_code, check_out, check_err) = @process.collect_output(
      "node",
      ["--check", "examples/p0/browser/host/" + host],
      no_console_window=true,
    )
    println(check_out.text())
    println(check_err.text())
    if check_code != 0 {
      fail("host syntax check failed: " + host)
    }
  }
  let dist = ".work/browser-dist"
  for
    name in [
      "surface.mjs", "wasm-imports.mjs", "layer-renderer.mjs", "application.mjs",
    ] {
    assert_eq(
      @process.run(
        "node",
        ["--check", "browser_host/runtime/" + name],
        no_console_window=true,
      ),
      0,
    )
  }
  assert_eq(
    @process.run(
      moon,
      [
        "-C", "browser_host", "build", "app/diagnostics/probe", "--target", "js",
        "--release", "--deny-warn",
      ],
      no_console_window=true,
    ),
    0,
  )
  assert_eq(
    @process.run(
      moon,
      [
        "-C", "browser_host", "build", "app/diagnostics", "--target", "js", "--release",
        "--deny-warn",
      ],
      no_console_window=true,
    ),
    0,
  )
  if !@fs.exists(dist) {
    @fs.mkdir(dist, recursive=true)
  }
  let copies = [
    (
      "browser_host/_build/js/release/build/local/browser_host/diagnostics/diagnostics.js",
      ".work/browser-dist/input-diagnostics.mjs",
    ),
    (
      "_build/js/release/build/tools/browser_buffer/browser_buffer.js", ".work/browser-dist/browser-buffer.mjs",
    ),
    (
      ".work/websys-input/generated/runtime.mjs", ".work/browser-dist/websys-input.mjs",
    ),
    (".work/websys-input/LICENSE", ".work/browser-dist/LICENSE-websys"),
    (
      ".work/websys-input/async-dependency/LICENSE", ".work/browser-dist/LICENSE-async",
    ),
    ("examples/p0/browser/host/index.html", ".work/browser-dist/index.html"),
    ("examples/p0/browser/host/style.css", ".work/browser-dist/style.css"),
    ("examples/p0/browser/host/host.mjs", ".work/browser-dist/host.mjs"),
    ("browser_host/runtime/surface.mjs", ".work/browser-dist/surface.mjs"),
    (
      "browser_host/_build/js/release/build/local/browser_host/gpu_probe/gpu_probe.js",
      ".work/browser-dist/gpu-probe.mjs",
    ),
    (
      "browser_host/_build/wasm-gc/release/build/local/browser_host/gpu_probe/gpu_probe.wasm",
      ".work/browser-dist/gpu-probe.wasm",
    ),
    (
      "browser_host/runtime/layer-renderer.mjs", ".work/browser-dist/layer-renderer.mjs",
    ),
    (
      "browser_host/runtime/wasm-imports.mjs", ".work/browser-dist/wasm-imports.mjs",
    ),
    ("examples/p0/browser/host/loader.mjs", ".work/browser-dist/loader.mjs"),
    (
      "examples/p0/browser/host/loader-common.mjs", ".work/browser-dist/loader-common.mjs",
    ),
    (
      "examples/p0/browser/host/environment-dev.mjs", ".work/browser-dist/environment.mjs",
    ),
    (
      "examples/p0/browser/host/text-renderer.mjs", ".work/browser-dist/text-renderer.mjs",
    ),
    (
      "browser_host/_build/js/release/build/local/browser_host_dev/browser_host_dev.js",
      ".work/browser-dist/app.mjs",
    ),
    (
      "browser_host/_build/wasm-gc/release/build/local/browser_host_dev/browser_host_dev.wasm",
      ".work/browser-dist/app.wasm",
    ),
    (".work/text-assets/NotoSansJP.ttf", ".work/browser-dist/NotoSansJP.ttf"),
    (".work/text-assets/OFL.txt", ".work/browser-dist/OFL.txt"),
  ]
  let font = ".work/text-assets/NotoSansJP.ttf"
  let license = ".work/text-assets/OFL.txt"
  if !@fs.exists(font) || !@fs.exists(license) {
    let (code, out, err) = @process.collect_output(
      moon,
      ["run", "scripts/verify-text-layout.mbtx"],
      no_console_window=true,
    )
    println(out.text())
    println(err.text())
    if code != 0 {
      fail("text layout asset generation failed")
    }
  }
  let expected_hash = "c2f3b4d463500a2ddcd3849cded1fceeb9fd6d1c32e6cbecd568453ba50fc68f"
  let expected_hash_upper = "C2F3B4D463500A2DDCD3849CDED1FCEEB9FD6D1C32E6CBECD568453BA50FC68F"
  let (hash_code, hash_out, hash_err) = @process.collect_output(
    "certutil.exe",
    ["-hashfile", font, "SHA256"],
    no_console_window=true,
  )
  println(@utf8.decode_lossy(hash_err.binary()))
  if hash_code != 0 {
    fail("font hash failed")
  }
  let mut hash_found = false
  for line in @utf8.decode_lossy(hash_out.binary()).split("\n") {
    let value = line.trim().to_owned()
    if value == expected_hash || value == expected_hash_upper {
      hash_found = true
    }
  }
  if !hash_found {
    fail("font hash mismatch")
  }
  for entry in copies {
    let (source, destination) = entry
    @fs.write_file(destination, @fs.read_file(source).binary())
  }
  assert_eq(
    @process.run(
      moon,
      ["run", "scripts/package-browser-notes.mbtx"],
      no_console_window=true,
    ),
    0,
  )
  assert_eq(
    @process.run(
      moon,
      ["run", "scripts/package-browser-async-pair.mbtx"],
      no_console_window=true,
    ),
    0,
  )
}

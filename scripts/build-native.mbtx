import {
  "moonbitlang/async@0.21.2",
  "moonbitlang/async@0.21.2/fs",
  "moonbitlang/async@0.21.2/process",
  "moonbitlang/core/env",
}

///|
fn fail(message : String) -> Unit {
  println(message)
  abort(message)
}

///|
fn package_path(value : String) -> Bool {
  value != "" &&
  !value.has_prefix("-") &&
  value
  .split("/")
  .all(part => {
    part != "" &&
    part != "." &&
    part != ".." &&
    part
    .iter()
    .all(c => {
      (c >= 'a' && c <= 'z') ||
      (c >= 'A' && c <= 'Z') ||
      (c >= '0' && c <= '9') ||
      c == '_' ||
      c == '-' ||
      c == '.'
    })
  })
}

///|
async fn main {
  @async.with_timeout(300000, async fn() {
    let mode = match @env.get_env_var("METONIC_NATIVE_BUILD") {
      Some(value) => value
      None => "headless"
    }
    let external = mode == "application" || mode == "application-release"
    let workspace = if external {
      let directory = @env.get_env_var("METONIC_NATIVE_WORKSPACE").unwrap_or("")
      if directory == "" {
        fail("METONIC_NATIVE_WORKSPACE is required for application builds")
      }
      @fs.realpath(directory)
    } else {
      "native_host"
    }
    let entry = @env.get_env_var("METONIC_NATIVE_PACKAGE").unwrap_or("")
    let artifact = @env.get_env_var("METONIC_NATIVE_ARTIFACT").unwrap_or("")
    if external {
      if !package_path(entry) || !package_path(artifact) {
        fail(
          "application builds require relative METONIC_NATIVE_PACKAGE and qualified METONIC_NATIVE_ARTIFACT paths",
        )
      }
      if !@fs.exists(workspace + "/moon.work") ||
        !@fs.exists(workspace + "/" + entry + "/moon.pkg") {
        fail("application workspace or entry package manifest is missing")
      }
    }
    if !external &&
      mode != "notes" &&
      mode != "notes-release" &&
      mode != "notes-probe" &&
      mode != "headless" &&
      mode != "window" &&
      mode != "window-release" &&
      mode != "release-probe" &&
      mode != "accessibility-probe" &&
      mode != "mailbox-probe" &&
      mode != "sdk-mailbox-probe" &&
      mode != "production-probes" &&
      mode != "window-dev" &&
      mode != "window-display-dev" &&
      mode != "window-probe" &&
      mode != "async" &&
      mode != "surface" &&
      mode != "host-gpu" {
      fail("invalid native build mode: " + mode)
    }
    let moon = @fs.realpath(".tools/moonbit/bin/moon.exe")
    let moon_home = @fs.realpath(".tools/moonbit")
    if external ||
      mode == "notes" ||
      mode == "notes-release" ||
      mode == "notes-probe" ||
      mode == "window" ||
      mode == "window-release" ||
      mode == "window-dev" ||
      mode == "window-display-dev" ||
      mode == "window-probe" {
      if @process.run(
          moon,
          ["run", "scripts/prepare-text-assets.mbtx"],
          no_console_window=true,
        ) !=
        0 {
        fail("native text asset preparation failed")
      }
    }
    if @process.run(
        moon,
        ["run", "scripts/prepare-wgpu.mbtx"],
        no_console_window=true,
      ) !=
      0 {
      fail("wgpu asset preparation failed")
    }
    let program_files = @env.get_env_var("ProgramFiles(x86)").unwrap_or(
      "C:/Program Files (x86)",
    )
    let vswhere = program_files +
      "/Microsoft Visual Studio/Installer/vswhere.exe"
    let (where_code, where_out, where_err) = @process.collect_output(
      vswhere,
      [
        "-utf8", "-latest", "-products", "*", "-requires", "Microsoft.VisualStudio.Component.VC.Tools.x86.x64",
        "-property", "installationPath",
      ],
      no_console_window=true,
    )
    if where_code != 0 {
      fail(where_err.text())
    }
    let install = where_out.text().trim().to_owned()
    if install == "" ||
      install.contains("\r") ||
      install.contains("\n") ||
      install.contains("\"") {
      fail("invalid Visual Studio installation")
    }
    let dir = ".work/native-build-env"
    if !@fs.exists(dir) {
      @fs.mkdir(dir, recursive=true)
    }
    let script = dir + "/vs-env.cmd"
    @fs.write_file(
      script,
      "@echo off\r\nchcp 65001>nul\r\ncall \"" +
      install +
      "/Common7/Tools/VsDevCmd.bat\" -no_logo -arch=x64 -host_arch=x64\r\nif errorlevel 1 exit /b 1\r\nset\r\n",
    )
    let (cmd_code, cmd_out, cmd_err) = @process.collect_output(
      "cmd.exe",
      ["/d", "/c", ".work\\native-build-env\\vs-env.cmd"],
      no_console_window=true,
    )
    if cmd_code != 0 {
      fail(cmd_err.text())
    }
    let envmap : Map[String, String] = Map([])
    for line in cmd_out.text().split("\n") {
      let item = line.trim_end(chars="\r")
      match item.find("=") {
        Some(i) => {
          let key = item[:i].to_owned()
          if key != "" {
            envmap.set(key, item[i + 1:].to_owned())
          }
        }
        None => ()
      }
    }
    envmap.set("MOON_HOME", moon_home)
    envmap.set("MOON_CC", "cl")
    envmap.set("VSLANG", "1033")
    envmap.set("MBT_WGPU_NATIVE_ROOT", @fs.realpath(".work/wgpu-assets"))
    envmap.set("MBT_WGPU_LINK_MODE", "static")
    let display_library = if mode == "window-display-dev" {
      if @process.run(
          moon,
          ["run", "scripts/prepare-display-feedback.mbtx"],
          extra_env=envmap,
          no_console_window=true,
        ) !=
        0 {
        fail("display feedback preparation failed")
      }
      let target = @env.get_env_var("CARGO_TARGET_DIR").unwrap_or(
        ".work/wgpu-display-feedback/source/target",
      )
      let library = @fs.realpath(target + "/debug")
      let definition = library + "/metonic_display_feedback.def"
      @fs.write_file(
        definition, "LIBRARY wgpu_native.dll\nEXPORTS\n  metonicSurfaceReadDisplayFeedback\n",
      )
      // WhyNot: importing all wgpu exports collides with the binding's dynamic loader.
      let vc_tools = envmap.get("VCToolsInstallDir").unwrap_or("")
      if vc_tools == "" {
        fail("Visual Studio library tool directory missing")
      }
      let librarian = @fs.realpath(vc_tools + "/bin/Hostx64/x64/lib.exe")
      if @process.run(
          librarian,
          [
            "/nologo",
            "/machine:x64",
            "/def:" + definition,
            "/out:" + library + "/metonic_display_feedback.lib",
          ],
          extra_env=envmap,
          no_console_window=true,
        ) !=
        0 {
        fail("display feedback import library creation failed")
      }
      envmap.set("LIB", library + ";" + envmap.get("LIB").unwrap_or(""))
      envmap.set(
        "LINK",
        "metonic_display_feedback.lib " + envmap.get("LINK").unwrap_or(""),
      )
      envmap.set("MBT_WGPU_LINK_MODE", "dynamic")
      Some(library)
    } else {
      None
    }
    if mode == "host-gpu" {
      if @process.run(
          moon,
          ["run", "scripts/prepare-native-deps.mbtx"],
          extra_env=envmap,
          no_console_window=true,
        ) !=
        0 {
        fail("native dependency preparation failed")
      }
      let native_host_build_dir = @fs.realpath(".") + "/.work/native-host-build"
      if @process.run(
          moon,
          [
            "-C", "native_host", "build", "../experiments/window_gpu_async", "--target",
            "native", "--target-dir", native_host_build_dir,
          ],
          extra_env=envmap,
          no_console_window=true,
        ) !=
        0 {
        fail("MoonBit host GPU build failed")
      }
      let required_exe = native_host_build_dir +
        "/native/debug/build/local/window_gpu_async/window_gpu_async.exe"
      if !@fs.exists(required_exe) {
        fail("native host GPU build artifact missing")
      }
      println("NATIVE_BUILD_OK mode=host-gpu")
      return
    }
    if external ||
      mode == "notes" ||
      mode == "notes-release" ||
      mode == "notes-probe" ||
      mode == "async" ||
      mode == "window" ||
      mode == "window-release" ||
      mode == "release-probe" ||
      mode == "accessibility-probe" ||
      mode == "mailbox-probe" ||
      mode == "sdk-mailbox-probe" ||
      mode == "production-probes" ||
      mode == "window-dev" ||
      mode == "window-display-dev" ||
      mode == "window-probe" {
      let host_apps = match mode {
        "application" | "application-release" => [entry]
        "notes" | "notes-release" => ["notes_app"]
        "notes-probe" => ["notes_probe"]
        "async" => ["async_app"]
        "window-dev" => ["window_dev"]
        "window-display-dev" => ["window_display_dev"]
        "window-probe" => ["window_probe"]
        "release-probe" => ["release_probe"]
        "accessibility-probe" => ["accessibility_probe"]
        "mailbox-probe" => ["mailbox_probe"]
        "sdk-mailbox-probe" => ["sdk_mailbox_probe"]
        "production-probes" =>
          [
            "release_probe", "accessibility_probe", "mailbox_probe", "sdk_mailbox_probe",
          ]
        _ => ["window_app"]
      }
      let needs_accesskit = fn(host_app : String) {
        external ||
        [
          "notes_app", "notes_probe", "window_app", "window_dev", "window_display_dev",
          "accessibility_probe", "mailbox_probe", "sdk_mailbox_probe", "window_probe",
        ].contains(host_app)
      }
      let native_host_build_dir = if external {
        workspace + "/.metonic-build"
      } else {
        @fs.realpath(".") + "/.work/native-host-build"
      }
      let build_args = ["-C", workspace, "build"]
      for host_app in host_apps {
        build_args.push(host_app)
      }
      for
        arg in [
          "--target", "native", "--target-dir", native_host_build_dir, "--deny-warn",
        ] {
        build_args.push(arg)
      }
      if host_apps.any(needs_accesskit) {
        guard @process.run(
            moon,
            ["run", "scripts/prepare-accesskit.mbtx"],
            no_console_window=true,
          ) ==
          0 else {
          fail("AccessKit preparation failed")
        }
        guard @process.run(
            moon,
            ["run", "scripts/prepare-accesskit-focus.mbtx"],
            no_console_window=true,
          ) ==
          0 else {
          fail("AccessKit focus build failed")
        }
        let accesskit = @fs.realpath(
          ".work/accesskit-assets/accesskit-c-0.22.3",
        )
        envmap.set(
          "INCLUDE",
          accesskit + "/include;" + envmap.get("INCLUDE").unwrap_or(""),
        )
        envmap.set(
          "LIB",
          accesskit +
          "/lib/windows/x86_64/msvc/shared;" +
          envmap.get("LIB").unwrap_or(""),
        )
      }
      let profile = if mode == "window-release" ||
        mode == "notes-release" ||
        mode == "application-release" {
        build_args.push("--release")
        "release"
      } else {
        "debug"
      }
      let ime_config = if mode == "window-probe" { "fixture" } else { profile }
      for variable in ["CL", "_CL_"] {
        assert_false(
          envmap.get(variable).unwrap_or("").contains("METONIC_IME_TRACE"),
          msg="IME trace settings must come from the build mode, not " +
            variable,
        )
      }
      let prepare_args = ["run", "scripts/prepare-native-deps.mbtx"]
      // These probes do not link the window module; selecting debug IME flags
      // would invalidate the production application's manifest unnecessarily.
      if host_apps.any(fn(host_app) {
          ![
            "release_probe", "accessibility_probe", "mailbox_probe", "sdk_mailbox_probe",
          ].contains(host_app)
        }) {
        prepare_args.push("--")
        prepare_args.push("--ime-config")
        prepare_args.push(ime_config)
      }
      guard @process.run(
          moon,
          prepare_args,
          extra_env=envmap,
          no_console_window=true,
        ) ==
        0 else {
        fail("native IME configuration failed")
      }
      let build_code = @process.run(
        moon,
        build_args,
        extra_env=envmap,
        no_console_window=true,
      )
      if build_code != 0 {
        fail("MoonBit host " + mode + " build failed")
      }
      for host_app in host_apps {
        let package_artifact = if external {
          artifact
        } else {
          "local/native_host/" + host_app
        }
        let name = package_artifact
          .split("/")
          .to_array()
          .last()
          .unwrap()
          .to_owned()
        let directory = native_host_build_dir +
          "/native/" +
          profile +
          "/build/" +
          package_artifact
        let required_exe = directory + "/" + name + ".exe"
        if !@fs.exists(required_exe) {
          fail("native host " + mode + " build artifact missing")
        }
        if needs_accesskit(host_app) {
          @fs.write_file(
            directory + "/accesskit.dll",
            @fs.read_file(".work/accesskit-focus-build/release/accesskit.dll").binary(),
          )
          if display_library is Some(library) {
            @fs.write_file(
              directory + "/wgpu_native.dll",
              @fs.read_file(library + "/wgpu_native.dll").binary(),
            )
          }
          for license in ["MIT", "APACHE"] {
            @fs.write_file(
              directory + "/ACCESSKIT-LICENSE-" + license,
              @fs.read_file(
                ".work/accesskit-assets/accesskit-c-0.22.3/LICENSE-" + license,
              ).binary(),
            )
          }
        }
      }
      println("NATIVE_BUILD_OK mode=" + mode)
      return
    }
    if @process.run(
        moon,
        [
          "build", "examples/p0/native_headless", "--target", "native", "--release",
          "--deny-warn",
        ],
        extra_env=envmap,
        no_console_window=true,
      ) !=
      0 {
      fail("MoonBit headless build failed")
    }
    let headless_exe = "_build/native/release/build/examples/p0/native_headless/native_headless.exe"
    let required_exe = if mode == "surface" {
      "_build/native/release/build/tools/native_surface_probe/native_surface_probe.exe"
    } else {
      headless_exe
    }
    if mode == "surface" {
      // Included headers may not invalidate the cached C stub.
      let stale = "_build/native/release/build/tools/native_surface_probe/bridge.obj"
      if @fs.exists(stale) {
        @fs.remove(stale)
      }
      if @process.run(
          moon,
          [
            "build", "tools/native_surface_probe", "--target", "native", "--release",
            "--deny-warn",
          ],
          extra_env=envmap,
          no_console_window=true,
        ) !=
        0 {
        fail("MoonBit native build failed")
      }
      if !@fs.exists(required_exe) {
        fail("native build artifact missing")
      }
      let debug_stub = "_build/native/debug/build/tools/native_surface_probe/bridge.obj"
      if @fs.exists(debug_stub) {
        @fs.remove(debug_stub)
      }
      assert_eq(
        @process.run(
          moon,
          [
            "build", "tools/native_surface_probe", "--target", "native", "--debug",
            "--deny-warn",
          ],
          extra_env=envmap,
          no_console_window=true,
        ),
        0,
      )
    }
    if !@fs.exists(headless_exe) {
      fail("native headless artifact missing")
    }
    println("NATIVE_BUILD_OK mode=" + mode)
  })
}

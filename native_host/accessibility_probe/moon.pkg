import {
  "moonbitlang/async",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
  "moonbitlang/async/process",
  "moonbitlang/async/fs",
  "moonbitlang/core/json",
  "mizchi/image",
  "local/p0/text_raster" @raster,
  "local/p0/tools/recording_contract" @recording,
  "local/native_host/accessibility",
  "local/native_host/uia_test_bridge" @uia,
}

pkgtype(kind: "executable")

supported_targets = "native"

options(
  link: {
    "native": {
      "cc-link-flags": "user32.lib dwmapi.lib uiautomationcore.lib ole32.lib oleaut32.lib",
    },
  },
)

import {
  "local/native_host/window_host",
  "local/native_host/application" @host_application,
  "local/native_host/p0_application",
  "local/p0/examples/p0/application",
  "local/p0/core/semantics",
  "local/p0/native_gpu" @gpu,
  "Milky2018/wgpu_mbt" @wgpu,
}

supported_targets = "native"

options(
  // Debug adapter types need these imports; release selects only the entry point.
  warn_list: "-29",
  targets: {
    "handle.mbt": [ "debug" ],
    "observation.mbt": [ "debug" ],
    "adapter_debug.mbt": [ "debug" ],
    "adapter_release.mbt": [ "release" ],
  },
)

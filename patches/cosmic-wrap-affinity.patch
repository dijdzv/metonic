+///|
+test "wrapped hit cursor stays on the clicked visual line" {
+  for text in ["abcdef", "ab cd ef", "אבגדהו", "abאבcd"] {
+    let buffer = Buffer::new(Metrics::new(12.0F, 12.0F))
+      .set_text(text, AttrsList::new(Attrs::new()), Advanced)
+      .set_size(Some(24.0F), Some(96.0F))
+      .set_wrap(WordOrGlyph)
+      .layout_all()
+    let runs = buffer.layout_runs().to_array()
+    assert_true(runs.length() > 1)
+    for run in runs {
+      for x in [1.0F, 23.0F] {
+        let cursor = buffer.hit(x, run.line_top + 6.0F).unwrap()
+        let editor = Editor::new(buffer).set_cursor(cursor)
+        assert_eq(editor.cursor_position().unwrap().1, run.line_top.to_double().to_int(), msg=text)
+        let renderer = TestRenderer::{ rects: [], glyph_pos: [] }
+        editor.render(renderer, Color::rgb(0, 0, 0), Color::rgb(255, 0, 0), Color::rgb(0, 0, 255), Color::rgb(0, 255, 0))
+        assert_eq(renderer.rects.length(), 1, msg=text)
+      }
+    }
+  }
+}
+
+///|
+test "vertical motion retains destination visual line at wrap boundary" {
+  let buffer = Buffer::new(Metrics::new(12.0F, 12.0F))
+    .set_text("abcdef", AttrsList::new(Attrs::new()), Advanced)
+    .set_size(Some(24.0F), Some(48.0F))
+    .set_wrap(WordOrGlyph)
+    .layout_all()
+  let (middle, x) = buffer.cursor_motion(Cursor::new(0, 0), None, Down).unwrap()
+  assert_eq(Editor::new(buffer).set_cursor(middle).cursor_position(), Some((0, 12)))
+  let (last, x2) = buffer.cursor_motion(middle, x, Down).unwrap()
+  assert_eq(Editor::new(buffer).set_cursor(last).cursor_position(), Some((0, 24)))
+  assert_eq(x, x2)
+  let (back, _) = buffer.cursor_motion(last, x2, Up).unwrap()
+  assert_eq(Editor::new(buffer).set_cursor(back).cursor_position(), Some((0, 12)))
+}
+
+///|
+test "vertical source run respects boundary affinity" {
+  let buffer = Buffer::new(Metrics::new(12.0F, 12.0F))
+    .set_text("abcdef", AttrsList::new(Attrs::new()), Advanced)
+    .set_size(Some(24.0F), Some(48.0F))
+    .set_wrap(WordOrGlyph)
+    .layout_all()
+  let before = Cursor::new_with_affinity(0, 2, Before)
+  let (before_end, _) = buffer.cursor_motion(before, None, End).unwrap()
+  assert_true(before_end == before)
+  assert_true(buffer.cursor_motion(before, None, Up) is None)
+  let (next, _) = buffer.cursor_motion(before, None, Down).unwrap()
+  assert_eq(Editor::new(buffer).set_cursor(next).cursor_position(), Some((24, 12)))
+  let after = Cursor::new_with_affinity(0, 2, After)
+  let (after_end, _) = buffer.cursor_motion(after, None, End).unwrap()
+  assert_true(after_end == Cursor::new_with_affinity(0, 4, Before))
+  let (previous, _) = buffer.cursor_motion(after, None, Up).unwrap()
+  assert_eq(Editor::new(buffer).set_cursor(previous).cursor_position(), Some((0, 0)))
+}

+///|
+test "wrapped cursor affinity selects one visual line" {
+  let buffer = Buffer::new(Metrics::new(12.0F, 12.0F))
+    .set_text("abcdef", AttrsList::new(Attrs::new()), Advanced)
+    .set_size(Some(24.0F), Some(48.0F))
+    .set_wrap(WordOrGlyph)
+    .layout_all()
+  let before = Editor::new(buffer).set_cursor(Cursor::new_with_affinity(0, 2, Before))
+  let after = Editor::new(buffer).set_cursor(Cursor::new_with_affinity(0, 2, After))
+  assert_eq(before.cursor_position(), Some((24, 0)))
+  assert_eq(after.cursor_position(), Some((0, 12)))
+  for editor in [before, after] {
+    let renderer = TestRenderer::{ rects: [], glyph_pos: [] }
+    editor.render(renderer, Color::rgb(0, 0, 0), Color::rgb(255, 0, 0), Color::rgb(0, 0, 255), Color::rgb(0, 255, 0))
+    assert_eq(renderer.rects.length(), 1)
+    let position = editor.cursor_position().unwrap()
+    assert_eq((renderer.rects[0].0, renderer.rects[0].1), position)
+  }
+}

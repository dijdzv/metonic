diff --git a/webapi-gen/emit/nullable_attribute_wbtest.mbt b/webapi-gen/emit/nullable_attribute_wbtest.mbt
new file mode 100644
index 0000000..ccd6198
--- /dev/null
+++ b/webapi-gen/emit/nullable_attribute_wbtest.mbt
@@ -0,0 +1,23 @@
+///|
+test "nullable attributes preserve Option and runtime conversion" {
+  let emitter = make_interface_emitter(
+    #|interface ReadableStream {};
+    #|interface Response {
+    #|  readonly attribute ReadableStream? body;
+    #|  readonly attribute DOMString? label;
+    #|  static readonly attribute ReadableStream? current;
+    #|  readonly attribute boolean ok;
+    #|};
+  )
+  let (_, emits) = emitter.emit("Response")
+  let code = mbt_code_gen_multi(emits)
+  assert_true(code.shared.contains("body(self : Self) -> ReadableStream?"))
+  assert_true(code.shared.contains("response_body_ffi(TJsValue::to_js(self)).to_option()"))
+  assert_true(code.shared.contains("label(self : Self) -> String?"))
+  assert_true(code.shared.contains("response_label_ffi(TJsValue::to_js(self)).to_option_prim()"))
+  assert_true(code.shared.contains("Response::current() -> ReadableStream?"))
+  assert_true(code.shared.contains("response_current_ffi().to_option()"))
+  assert_true(code.shared.contains("ok(self : Self) -> Bool"))
+  assert_true(code.js_ffi.contains("-> JsValue"))
+  assert_true(code.wasm_ffi.contains("-> JsValue"))
+}
diff --git a/webapi-gen/emit/numeric_alias_wbtest.mbt b/webapi-gen/emit/numeric_alias_wbtest.mbt
new file mode 100644
index 0000000..5718460
--- /dev/null
+++ b/webapi-gen/emit/numeric_alias_wbtest.mbt
@@ -0,0 +1,14 @@
+///|
+test "runtime numeric detection follows aliases without treating unknown types as integers" {
+  let definitions = @parser.parse("typedef unsigned long long Size; typedef Size Alias; typedef Alias? Maybe; typedef B A; typedef A B;")
+  let registry = @type_registry.TypeRegistry::new(definitions)
+  let aliases = {}
+  for definition in definitions {
+    if definition.definition is Typedef(td) { aliases[td.name] = td }
+  }
+  registry.set_typedef_defs(aliases)
+  assert_true(is_bigint_type(Identifier("Alias"), registry~))
+  assert_true(is_bigint_type(Identifier("Maybe"), registry~))
+  assert_false(is_bigint_type(Identifier("Unknown"), registry~))
+  assert_false(is_bigint_type(Identifier("A"), registry~))
+}

--- a/webapi-gen/type_mapping/type_mapping.mbt
+++ b/webapi-gen/type_mapping/type_mapping.mbt
@@ -258,8 +258,12 @@ pub fn arg_mbt_type(
         @type_registry.NamedTypeKind::Interface => ArgMbtType::Interface(name)
         @type_registry.NamedTypeKind::Enum => ArgMbtType::Enum(name)
         @type_registry.NamedTypeKind::Dictionary => ArgMbtType::Dictionary(name)
+        @type_registry.NamedTypeKind::Typedef =>
+          match type_registry.resolve_type(Identifier(name)) {
+            Some(LongLong | UnsignedLongLong | Bigint | Long | UnsignedLong | Short | UnsignedShort | Byte | Octet | Boolean | Float | UnrestrictedFloat | Double | UnrestrictedDouble) => ArgMbtType::Primitive(name)
+            _ => ArgMbtType::Other(name)
+          }
         @type_registry.NamedTypeKind::UnionTypedef
-        | @type_registry.NamedTypeKind::Typedef
         | @type_registry.NamedTypeKind::Callback
         | @type_registry.NamedTypeKind::Unknown => ArgMbtType::Other(name)
       }
diff --git a/webapi-gen/type_registry/resolve_type.mbt b/webapi-gen/type_registry/resolve_type.mbt
new file mode 100644
index 0000000..04c68cd
--- /dev/null
+++ b/webapi-gen/type_registry/resolve_type.mbt
@@ -0,0 +1,26 @@
+///|
+pub fn TypeRegistry::resolve_type(
+  self : TypeRegistry,
+  type_ : @parser.Type,
+) -> @parser.Type? {
+  let visited : @hashset.HashSet[String] = @hashset.new()
+  let mut current = type_
+  let mut nullable = false
+  loop current {
+    @parser.Type::Nullable(inner) => {
+      nullable = true
+      current = inner
+      continue current
+    }
+    @parser.Type::Identifier(name) => {
+      guard self.typedef_defs.get(name) is Some(definition) else {
+        return Some(if nullable { @parser.Type::Nullable(current) } else { current })
+      }
+      if visited.contains(name) { return None }
+      visited.add(name)
+      current = definition.type_
+      continue current
+    }
+    _ => return Some(if nullable { @parser.Type::Nullable(current) } else { current })
+  }
+}
diff --git a/webapi-gen/type_registry/resolve_type_wbtest.mbt b/webapi-gen/type_registry/resolve_type_wbtest.mbt
new file mode 100644
index 0000000..b822208
--- /dev/null
+++ b/webapi-gen/type_registry/resolve_type_wbtest.mbt
@@ -0,0 +1,34 @@
+///|
+fn registry_for(source : String) -> TypeRegistry raise {
+  let definitions = @parser.parse(source)
+  let registry = TypeRegistry::new(definitions)
+  let aliases = {}
+  for definition in definitions {
+    if definition.definition is Typedef(td) {
+      aliases[td.name] = td
+    }
+  }
+  registry.set_typedef_defs(aliases)
+  registry
+}
+
+///|
+test "alias resolution retains numeric identity and nullable wrappers" {
+  let registry = registry_for(
+    "typedef unsigned long long Size; typedef Size Alias; typedef Alias? Maybe; typedef bigint Big; typedef Big BigAlias;",
+  )
+  assert_eq(registry.resolve_type(Identifier("Alias")), Some(UnsignedLongLong))
+  assert_eq(registry.resolve_type(Identifier("Maybe")), Some(Nullable(UnsignedLongLong)))
+  assert_eq(registry.resolve_type(Nullable(Identifier("Alias"))), Some(Nullable(UnsignedLongLong)))
+  assert_eq(registry.resolve_type(Identifier("BigAlias")), Some(Bigint))
+  assert_eq(registry.resolve_type(Identifier("Unknown")), Some(Identifier("Unknown")))
+  assert_eq(registry.resolve_type(LongLong), Some(LongLong))
+}
+
+///|
+test "self and mutual alias cycles terminate without a resolved type" {
+  let registry = registry_for("typedef B A; typedef A B; typedef Self Self;")
+  assert_eq(registry.resolve_type(Identifier("A")), None)
+  assert_eq(registry.resolve_type(Identifier("Self")), None)
+  assert_eq(registry.resolve_type(Nullable(Identifier("A"))), None)
+}

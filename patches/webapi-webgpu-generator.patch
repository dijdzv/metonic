diff --git a/webapi-gen/parser/typedef_attributes_test.mbt b/webapi-gen/parser/typedef_attributes_test.mbt
new file mode 100644
index 0000000..d536598
--- /dev/null
+++ b/webapi-gen/parser/typedef_attributes_test.mbt
@@ -0,0 +1,23 @@
+///|
+test "typedef preserves type attributes separately from definition attributes" {
+  let parsed = @parser.parse(
+    "[Exposed=Window] typedef [EnforceRange] unsigned long Flags;",
+  )
+  guard parsed[0].definition is Typedef(definition) else {
+    fail("expected typedef")
+  }
+  assert_eq(definition.type_, UnsignedLong)
+  assert_eq(definition.name, "Flags")
+  assert_eq(definition.type_extended_attributes, [NoArgs("EnforceRange")])
+  assert_eq(parsed[0].extended_attributes, [Ident("Exposed", "Window")])
+}
+
+///|
+test "typedef without type attributes retains an empty list" {
+  let parsed = @parser.parse("typedef unsigned long Flags;")
+  guard parsed[0].definition is Typedef(definition) else {
+    fail("expected typedef")
+  }
+  assert_eq(definition.type_extended_attributes, [])
+  assert_eq(definition.type_, UnsignedLong)
+}

diff --git a/webapi-gen/type_mapping/numeric_alias_wbtest.mbt b/webapi-gen/type_mapping/numeric_alias_wbtest.mbt
new file mode 100644
index 0000000..6ff01ef
--- /dev/null
+++ b/webapi-gen/type_mapping/numeric_alias_wbtest.mbt
@@ -0,0 +1,20 @@
+///|
+test "numeric aliases retain their public name and primitive ABI classification" {
+  let definitions = @parser.parse(
+    "typedef unsigned long Flags; typedef unsigned long long Size; typedef Size Alias; typedef DOMString Text; typedef B A; typedef A B;",
+  )
+  let registry = @type_registry.TypeRegistry::new(definitions)
+  let aliases = {}
+  for definition in definitions {
+    if definition.definition is Typedef(td) { aliases[td.name] = td }
+  }
+  registry.set_typedef_defs(aliases)
+  for name in ["Flags", "Size", "Alias"] {
+    let (mapped, _) = arg_mbt_type(Identifier(name), "Probe", "method", "value", registry)
+    assert_eq(mapped, Primitive(name))
+  }
+  for name in ["Text", "A", "Missing"] {
+    let (mapped, _) = arg_mbt_type(Identifier(name), "Probe", "method", "value", registry)
+    assert_eq(mapped, Other(name))
+  }
+}

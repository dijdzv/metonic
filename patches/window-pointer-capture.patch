diff --git a/modules/window/windows/pointer_capture_wbtest.mbt b/modules/window/windows/pointer_capture_wbtest.mbt
new file mode 100644
index 0000000..4adf08e
--- /dev/null
+++ b/modules/window/windows/pointer_capture_wbtest.mbt
@@ -0,0 +1,95 @@
+///|
+extern "C" fn capture_test_send(
+  hwnd : UInt64,
+  message : UInt,
+  keys : UInt64,
+  point : Int64,
+) -> Int64 = "SendMessageW"
+
+///|
+extern "C" fn capture_test_get() -> UInt64 = "GetCapture"
+
+///|
+extern "C" fn capture_test_set(hwnd : UInt64) -> UInt64 = "SetCapture"
+
+///|
+test "owned windows retain capture for held buttons and deliver final release before loss" {
+  reset_event_test_state()
+  let event_loop = EventLoop::new()
+  defer event_loop.drop()
+  let app : RecordingApp = { events: [], }
+  app_state_set_running(true)
+  app_state_set_dispatch_handler(app, event_loop.window_target())
+  defer {
+    app_state_clear_dispatch_handler()
+    app_state_set_running(false)
+  }
+  let window = event_loop.create_window(
+    @core.WindowAttributes::default().with_visible(false),
+  )
+  defer window.drop()
+  let other = event_loop.create_window(
+    @core.WindowAttributes::default().with_visible(false),
+  )
+  defer other.drop()
+  app_state_dispatch_deferred_callbacks()
+  app.events.clear()
+  let hwnd = window.native_window_handle()
+  let other_hwnd = other.native_window_handle()
+  ignore(capture_test_send(hwnd, 0x201U, 1UL, lparam_position(10, 20)))
+  assert_eq(capture_test_get(), hwnd)
+  ignore(capture_test_send(hwnd, 0x204U, 3UL, lparam_position(10, 20)))
+  ignore(capture_test_send(hwnd, 0x205U, 1UL, lparam_position(30, 40)))
+  assert_eq(capture_test_get(), hwnd)
+  assert_false(app.events.iter().any(event => event is PointerCanceled(_)))
+  ignore(capture_test_send(hwnd, 0x202U, 0UL, lparam_position(-12, 34)))
+  assert_eq(capture_test_get(), 0UL)
+  let count = app.events.length()
+  guard app.events[count - 2]
+    is PointerButton(_, Released, position, _, Mouse(Left)) else {
+    fail("Final release must precede capture loss")
+  }
+  assert_eq(position.x(), -12.0)
+  assert_eq(position.y(), 34.0)
+  assert_true(app.events[count - 1] is PointerCanceled(_))
+
+  ignore(capture_test_send(hwnd, 0x201U, 1UL, 0L))
+  app.events.clear()
+  ignore(capture_test_set(other_hwnd))
+  assert_eq(capture_test_get(), other_hwnd)
+  assert_true(app.events.iter().any(event => event is PointerCanceled(_)))
+  ignore(capture_test_send(hwnd, 0x202U, 0UL, 0L))
+  assert_eq(capture_test_get(), other_hwnd)
+
+  app.events.clear()
+  ignore(capture_test_send(other_hwnd, 0x1FU, 0UL, 0L))
+  assert_eq(capture_test_get(), 0UL)
+  assert_true(app.events.iter().any(event => event is PointerCanceled(_)))
+  assert_false(
+    app.events.iter().any(event => event is PointerButton(_, Released, _, _, _)),
+  )
+
+  app.events.clear()
+  ignore(capture_test_send(hwnd, 0x06U, 0UL, 0L))
+  assert_true(app.events.iter().any(event => event is Focused(false)))
+  ignore(capture_test_send(hwnd, 0x201U, 1UL, 0L))
+  window.drop()
+  assert_true(capture_test_get() != hwnd)
+  assert_true(app.events.iter().any(event => event is Destroyed))
+}
+
+///|
+test "pointer cancellation does not invent a legacy mouse release" {
+  assert_eq(
+    @core.WindowEvent::PointerCanceled(None).into_winit_events().length(),
+    0,
+  )
+  let app = begin_recording()
+  register_input_test_window(42)
+  dispatch_native_input_event(0, 22, 0UL, 0L)
+  dispatch_native_input_event(43, 22, 0UL, 0L)
+  assert_eq(app.events.length(), 0)
+  dispatch_native_input_event(42, 22, 0UL, 0L)
+  assert_eq(app.events.length(), 1)
+  assert_true(app.events[0] is PointerCanceled(None))
+}

+static int32_t mbw_apply_ime_area(HWND hwnd, MBWWindowState *state) {
+  if (!state || !state->has_ime_area || !mbw_load_imm32()) return 0;
+  typedef BOOL(WINAPI *set_candidate_t)(HIMC, LPCANDIDATEFORM);
+  typedef BOOL(WINAPI *set_composition_t)(HIMC, LPCOMPOSITIONFORM);
+  set_candidate_t candidate = (set_candidate_t)GetProcAddress(g_imm32, "ImmSetCandidateWindow");
+  set_composition_t composition = (set_composition_t)GetProcAddress(g_imm32, "ImmSetCompositionWindow");
+  if (!candidate || !composition) return 0;
+  HIMC context = g_imm_get_context(hwnd);
+  if (!context) return 0;
+  COMPOSITIONFORM form = {0};
+  form.dwStyle = CFS_POINT;
+  form.ptCurrentPos = state->ime_area.ptCurrentPos;
+  BOOL candidate_ok = candidate(context, &state->ime_area);
+  BOOL composition_ok = composition(context, &form);
+  g_imm_release_context(hwnd, context);
+  return candidate_ok && composition_ok;
+}
+
+int32_t mbw_set_ime_cursor_area(uint64_t raw_hwnd, int32_t x, int32_t y,
+                              int32_t width, int32_t height) {
+  HWND hwnd = (HWND)(uintptr_t)raw_hwnd;
+  MBWWindowState *state = mbw_window_state(hwnd);
+  if (!state || width < 1 || height < 1 ||
+      (int64_t)x + width > INT32_MAX || (int64_t)y + height > INT32_MAX) return 0;
+  CANDIDATEFORM area = {0};
+  area.dwIndex = 0;
+  area.dwStyle = CFS_EXCLUDE;
+  area.ptCurrentPos.x = x;
+  area.ptCurrentPos.y = y;
+  area.rcArea.left = x;
+  area.rcArea.top = y;
+  area.rcArea.right = x + width;
+  area.rcArea.bottom = y + height;
+  state->ime_area = area;
+  state->has_ime_area = TRUE;
+  return mbw_apply_ime_area(hwnd, state);
+}

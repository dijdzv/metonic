+#[cfg(all(windows, feature = "metonic-display-feedback"))]
+#[repr(C)]
+#[derive(Default)]
+pub struct MetonicDisplayFeedback {
+    pub last_present_count: u32,
+    pub observed_present_count: u32,
+    pub sync_qpc_time: i64,
+    pub present_refresh_count: u32,
+    pub sync_refresh_count: u32,
+}
+
+// The caller serializes this call with present, reconfiguration and destruction.
+// Only scalar observations escape; no borrowed HAL/COM handle is exposed.
+#[cfg(all(windows, feature = "metonic-display-feedback"))]
+#[no_mangle]
+pub unsafe extern "C" fn metonicSurfaceReadDisplayFeedback(
+    surface: native::WGPUSurface,
+    output: *mut MetonicDisplayFeedback,
+) -> i32 {
+    let Some(output) = output.as_mut() else { return -1; };
+    *output = MetonicDisplayFeedback::default();
+    let Some(surface) = surface.as_ref() else { return -1; };
+    let Some(raw) = surface.context.surface_as_hal::<hal::api::Dx12>(surface.id) else {
+        return 1;
+    };
+    let Some(chain) = raw.swap_chain() else { return 1; };
+    let last = match chain.GetLastPresentCount() {
+        Ok(value) => value,
+        Err(error) => return error.code().0,
+    };
+    output.last_present_count = last;
+    let mut statistics = Default::default();
+    if let Err(error) = chain.GetFrameStatistics(&mut statistics) {
+        return error.code().0;
+    }
+    *output = MetonicDisplayFeedback {
+        last_present_count: last,
+        observed_present_count: statistics.PresentCount,
+        sync_qpc_time: statistics.SyncQPCTime,
+        present_refresh_count: statistics.PresentRefreshCount,
+        sync_refresh_count: statistics.SyncRefreshCount,
+    };
+    0
+}

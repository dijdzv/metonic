+static int32_t mbw_queue_preedit_packet(MBWWindowState *state,
+                                       const char *text, int32_t text_len,
+                                       int32_t cursor,
+                                       const unsigned char *attributes,
+                                       int32_t attribute_len) {
+  if (text_len < 0 || attribute_len < 0 || attribute_len > INT32_MAX - 12 ||
+      text_len > INT32_MAX - 12 - attribute_len) return 0;
+  int32_t size = 12 + text_len + attribute_len;
+  unsigned char *packet = (unsigned char *)malloc((size_t)size);
+  if (!packet) return 0;
+  int32_t header[3] = {text_len, cursor, attribute_len};
+  memcpy(packet, header, 12);
+  if (text_len > 0) memcpy(packet + 12, text, (size_t)text_len);
+  if (attribute_len > 0) memcpy(packet + 12 + text_len, attributes, (size_t)attribute_len);
+  g_input_event_trampoline(g_input_event_closure, state->raw_id, 39,
+                          (uint64_t)(uintptr_t)packet, size);
+  return 1;
+}
+
+static void mbw_queue_preedit_attributes(HWND hwnd, MBWWindowState *state,
+                                         char *text, int32_t text_len,
+                                         int32_t cursor) {
+  unsigned char *attributes = NULL;
+  int32_t attribute_len = 0;
+  HIMC context = g_imm_get_context(hwnd);
+  if (context) {
+    LONG length = g_imm_get_composition_string(context, GCS_COMPATTR, NULL, 0);
+    if (length > 0 && length <= INT32_MAX - 12 - text_len) {
+      attributes = (unsigned char *)malloc((size_t)length);
+      if (attributes) {
+        LONG copied = g_imm_get_composition_string(context, GCS_COMPATTR, attributes, (DWORD)length);
+        if (copied > 0 && copied <= length) attribute_len = copied;
+      }
+    }
+    g_imm_release_context(hwnd, context);
+  }
+  mbw_queue_preedit_packet(state, text, text_len, cursor, attributes, attribute_len);
+  free(attributes);
+  free(text);
+}
+
+#ifdef METONIC_IME_TRACE_TEST
+int32_t mbw_ime_attributes_probe(uint64_t raw_hwnd, int32_t mode) {
+  MBWWindowState *state = mbw_window_state((HWND)(uintptr_t)raw_hwnd);
+  if (!state || !g_input_event_trampoline || !g_input_event_closure) return 0;
+  if (mode >= 3 && mode <= 5) {
+    int32_t *packet = (int32_t *)malloc(12);
+    if (!packet) return 0;
+    packet[0] = mode == 3 ? -1 : 0;
+    packet[1] = 0;
+    packet[2] = mode == 4 ? 1 : 0;
+    g_input_event_trampoline(g_input_event_closure, state->raw_id, 39,
+                            (uint64_t)(uintptr_t)packet, mode == 5 ? 8 : 12);
+    return 1;
+  }
+  const unsigned char selected[3] = {0, 1, 1};
+  const unsigned char cleared[3] = {0, 0, 0};
+  int32_t len = 0;
+  char *text = mbw_wide_to_utf8_alloc(L"\x306b\x307b\x3093", 3, &len);
+  if (!text) return 0;
+  int32_t result = mbw_queue_preedit_packet(state, text, len, mode == 0 ? 1 : 0,
+      mode == 0 ? selected : cleared, mode == 2 ? 1 : 3);
+  free(text);
+  return result;
+}
+#endif

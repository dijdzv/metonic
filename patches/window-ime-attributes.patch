diff --git a/modules/window/windows/event.mbt b/modules/window/windows/event.mbt
index d913639..9c8465d 100644
--- a/modules/window/windows/event.mbt
+++ b/modules/window/windows/event.mbt
@@ -1,3 +1,24 @@
+///|
+fn ime_packet_int(bytes : Bytes, offset : Int) -> Int {
+  bytes[offset].to_int() | (bytes[offset + 1].to_int() << 8) |
+  (bytes[offset + 2].to_int() << 16) | (bytes[offset + 3].to_int() << 24)
+}
+
+///|
+fn ime_attribute_packet(bytes : Bytes) -> @core.Ime? {
+  if bytes.length() < 12 { return None }
+  let size = ime_packet_int(bytes, 0)
+  let cursor = ime_packet_int(bytes, 4)
+  let count = ime_packet_int(bytes, 8)
+  if size < 0 || count < 0 || size > bytes.length() - 12 ||
+    count != bytes.length() - 12 - size { return None }
+  let text = @utf8.decode_lossy(bytes[12:12 + size], ignore_bom=false)
+  let range = if cursor >= 0 && cursor <= text.length() {
+    Some(@core.ImeCursorRange(cursor, cursor))
+  } else { None }
+  Some(@core.Ime::PreeditWithAttributes(text, range, bytes[12 + size:].to_owned()))
+}
+
 ///|
 fn dispatch_native_window_event(
   kind : Int,
@@ -209,6 +230,15 @@ fn dispatch_native_input_event(
   wparam : UInt64,
   lparam : Int64,
 ) -> Unit {
+  if kind == 39 {
+    let packet = native_consume_utf8_text(wparam, lparam.to_int())
+    if raw_id > 0 && app_state_window_handle(raw_id) is Some(_) {
+      if ime_attribute_packet(packet) is Some(event) {
+        app_state_queue_window_event(raw_id, Ime(event))
+      }
+    }
+    return
+  }
   if raw_id <= 0 || app_state_window_handle(raw_id) is None {
     return
   }

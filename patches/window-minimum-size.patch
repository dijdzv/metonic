diff --git a/modules/window/windows/minimum_size.mbt b/modules/window/windows/minimum_size.mbt
new file mode 100644
index 0000000..378c0fa
--- /dev/null
+++ b/modules/window/windows/minimum_size.mbt
@@ -0,0 +1,108 @@
+///|
+fn minimum_physical_size(
+  size : @dpi.Size,
+  scale : Double,
+) -> @dpi.PhysicalSize? {
+  let (width, height) = match size {
+    Physical(size) => (size.width.to_double(), size.height.to_double())
+    Logical(size) => (size.width * scale, size.height * scale)
+  }
+  if !@dpi.validate_scale_factor(scale) ||
+    !(width > 0.0 && width <= 2147483647.0) ||
+    !(height > 0.0 && height <= 2147483647.0) {
+    return None
+  }
+  let w = width.to_int()
+  let h = height.to_int()
+  Some(
+    @dpi.PhysicalSize(
+      if w.to_double() < width {
+        w + 1
+      } else {
+        w
+      },
+      if h.to_double() < height {
+        h + 1
+      } else {
+        h
+      },
+    ),
+  )
+}
+
+///|
+fn window_set_minimum(raw_id : Int, size : @dpi.Size?) -> Unit {
+  for entry in app_state_runtime.val.window_handles {
+    if entry.raw_id == raw_id {
+      let scale = native_get_dpi_for_window(entry.hwnd).to_double() / 96.0
+      match size {
+        None => entry.minimum = None
+        Some(value) =>
+          if minimum_physical_size(value, scale) is Some(physical) {
+            if minimum_outer_size(entry.hwnd, physical) is Some(_) {
+              entry.minimum = size
+            }
+          }
+      }
+      return
+    }
+  }
+}
+
+///|
+fn window_minimum_size(raw_id : Int) -> @dpi.PhysicalSize? {
+  for entry in app_state_runtime.val.window_handles {
+    if entry.raw_id == raw_id {
+      return match entry.minimum {
+        Some(value) =>
+          minimum_physical_size(
+            value,
+            native_get_dpi_for_window(entry.hwnd).to_double() / 96.0,
+          )
+        None => None
+      }
+    }
+  }
+  None
+}
+
+///|
+fn window_minimum_track_size(raw_id : Int) -> @dpi.PhysicalSize? {
+  guard app_state_window_handle(raw_id) is Some(hwnd) else { return None }
+  guard window_minimum_size(raw_id) is Some(size) else { return None }
+  minimum_outer_size(hwnd, size)
+}
+
+///|
+fn minimum_outer_size(
+  hwnd : UInt64,
+  size : @dpi.PhysicalSize,
+) -> @dpi.PhysicalSize? {
+  let rect : FixedArray[Int] = [0, 0, size.width, size.height]
+  let menu = if native_get_menu(hwnd) != 0UL { 1 } else { 0 }
+  if native_adjust_window_rect_ex_for_dpi(
+      rect,
+      native_get_window_long_style(hwnd).to_uint(),
+      menu,
+      native_get_window_long_ex_style(hwnd).to_uint(),
+      native_get_dpi_for_window(hwnd),
+    ) ==
+    0 {
+    return None
+  }
+  let width = rect[2].to_int64() - rect[0].to_int64()
+  let height = rect[3].to_int64() - rect[1].to_int64()
+  if width <= 0L || height <= 0L || width > 2147483647L || height > 2147483647L {
+    return None
+  }
+  Some(@dpi.PhysicalSize(width.to_int(), height.to_int()))
+}
+
+///|
+fn Window::enforce_minimum_size(self : Window) -> Unit {
+  guard self.min_inner_size() is Some(minimum) else { return }
+  let current = self.inner_size()
+  if current.width < minimum.width || current.height < minimum.height {
+    ignore(self.request_inner_size(current.into_size()))
+  }
+}
diff --git a/modules/window/windows/minimum_size_wbtest.mbt b/modules/window/windows/minimum_size_wbtest.mbt
new file mode 100644
index 0000000..c12bfd0
--- /dev/null
+++ b/modules/window/windows/minimum_size_wbtest.mbt
@@ -0,0 +1,61 @@
+///|
+test "minimum conversion retains physical pixels and rounds logical constraints up" {
+  for scale in [1.0, 1.25, 1.5, 2.0] {
+    assert_eq(
+      minimum_physical_size(@dpi.PhysicalSize(320, 360).into_size(), scale),
+      Some(@dpi.PhysicalSize(320, 360)),
+    )
+    let result = minimum_physical_size(
+      @dpi.LogicalSize(320.5, 360.5).into_size(),
+      scale,
+    ).unwrap()
+    assert_true(result.width.to_double() >= 320.5 * scale)
+    assert_true(result.width.to_double() < 320.5 * scale + 1.0)
+    assert_true(result.height.to_double() >= 360.5 * scale)
+    assert_true(result.height.to_double() < 360.5 * scale + 1.0)
+  }
+  assert_eq(
+    minimum_physical_size(@dpi.LogicalSize(0.5, 0.5).into_size(), 1.0),
+    Some(@dpi.PhysicalSize(1, 1)),
+  )
+}
+
+///|
+test "minimum conversion rejects invalid dimensions and scales before integer conversion" {
+  for value in [0.0, -1.0, 1.0 / 0.0, 0.0 / 0.0, 2147483648.0] {
+    assert_eq(
+      minimum_physical_size(@dpi.LogicalSize(value, 100.0).into_size(), 1.0),
+      None,
+    )
+    assert_eq(
+      minimum_physical_size(@dpi.LogicalSize(100.0, value).into_size(), 1.0),
+      None,
+    )
+  }
+  for scale in [0.0, -1.0, 1.0 / 0.0, 0.0 / 0.0] {
+    assert_eq(
+      minimum_physical_size(@dpi.PhysicalSize(320, 360).into_size(), scale),
+      None,
+    )
+  }
+  assert_eq(
+    minimum_physical_size(
+      @dpi.LogicalSize(2147483647.0, 100.0).into_size(),
+      2.0,
+    ),
+    None,
+  )
+}
+
+///|
+test "minimum state disappears when a window is unregistered" {
+  let saved = app_state_runtime.val
+  defer { app_state_runtime.val = saved }
+  app_state_runtime.val = AppStateRuntime::new()
+  app_state_register_window_handle(10, 0UL)
+  app_state_runtime.val.window_handles[0].minimum = Some(@dpi.PhysicalSize(320, 360).into_size())
+  app_state_unregister_window_handle(10)
+  assert_eq(window_minimum_size(10), None)
+  app_state_register_window_handle(10, 0UL)
+  assert_eq(app_state_runtime.val.window_handles[0].minimum, None)
+}

///|
test "query preview preserves committed ID and reset rejects late composition" {
  reset_state()
  let model = application.val
  assert_eq(@semantics.set_selection(model.editor, model.query_input, 0, 1), "")
  assert_eq(query_composition_start(), 1)
  assert_eq(text_begin(1), 1)
  assert_eq(text_put(0x65E5), 1)
  assert_eq(query_composition_update(), 1)
  assert_eq(query_preview.val, Some("日"))
  assert_eq(model.query(), "1")
  assert_eq(text_begin(1), 1)
  assert_eq(text_put(0x65E5), 1)
  assert_eq(query_commit(1, 1), 0)
  query_composition_end()
  assert_eq(query_preview.val, None)
  assert_eq(model.query(), "1")
  assert_eq(query_composition_start(), 1)
  query_composition_end()
  assert_eq(text_begin(2), 1)
  assert_eq(text_put(0x65E5), 1)
  assert_eq(text_put(0x672C), 1)
  assert_eq(query_commit(2, 2), 1)
  assert_eq(model.query(), "日本")
  assert_eq(editor_field(0), 0)
  assert_eq(query_composition_start(), 1)
  reset_state()
  assert_eq(text_begin(1), 1)
  assert_eq(text_put(0x672C), 1)
  assert_eq(query_composition_update(), 0)
  assert_eq(application.val.query(), "1")
}

--- /dev/null
+++ b/src/internal/pipe_test_support/stub.c
@@ -0,0 +1,34 @@
+#include <stdint.h>
+#include <moonbit.h>
+#ifdef _WIN32
+#include <windows.h>
+#pragma comment(lib, "advapi32.lib")
+MOONBIT_FFI_EXPORT
+int32_t metonic_test_restricted_pipe_open(const WCHAR *name) {
+  HANDLE original = NULL, restricted = NULL, client = INVALID_HANDLE_VALUE;
+  BYTE world[SECURITY_MAX_SID_SIZE];
+  DWORD size = sizeof(world), error;
+  SID_AND_ATTRIBUTES sid = {world, 0};
+  int32_t result = -1;
+  if (!CreateWellKnownSid(WinWorldSid, NULL, world, &size)) return -1;
+  if (!OpenProcessToken(GetCurrentProcess(), TOKEN_DUPLICATE | TOKEN_QUERY, &original)) return -2;
+  if (!CreateRestrictedToken(original, DISABLE_MAX_PRIVILEGE, 0, NULL,
+      0, NULL, 1, &sid, &restricted)) { result = -3; goto done; }
+  if (!ImpersonateLoggedOnUser(restricted)) { result = -4; goto done; }
+  client = CreateFileW(name, GENERIC_READ, 0, NULL,
+    OPEN_EXISTING, FILE_FLAG_OVERLAPPED, NULL);
+  error = GetLastError();
+  // Never yield to a MoonBit coroutine while the OS thread is impersonating.
+  if (!RevertToSelf()) ExitProcess(90);
+  result = client == INVALID_HANDLE_VALUE ? (int32_t)error : 0;
+done:
+  if (client != INVALID_HANDLE_VALUE) CloseHandle(client);
+  if (restricted) CloseHandle(restricted);
+  CloseHandle(original);
+  return result;
+}
+
+
+MOONBIT_FFI_EXPORT
+int32_t metonic_test_process_handle_count(void) { DWORD count; return GetProcessHandleCount(GetCurrentProcess(), &count) ? (int32_t)count : -1; }
+#endif

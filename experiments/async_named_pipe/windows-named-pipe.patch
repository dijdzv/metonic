diff --git a/src/internal/event_loop/pipe_accept_wbtest.mbt b/src/internal/event_loop/pipe_accept_wbtest.mbt
new file mode 100644
index 0000000..ca7cd1a
--- /dev/null
+++ b/src/internal/event_loop/pipe_accept_wbtest.mbt
@@ -0,0 +1,126 @@
+///|
+#cfg(platform="windows")
+async test "pending pipe accept cancellation allows another accept" {
+  let handle = @named_pipe.WindowsPipe::listen("metonic_accept_cancel.\{@env_util.current_process}")
+  defer handle.close()
+  for _ in 0..<3 {
+    let result = @async.with_timeout_opt(20, () => handle.accept())
+    assert_true(result is None)
+  }
+}
+
+///|
+#cfg(platform="windows")
+fn process_handle_count() -> Int { @pipe_test_support.process_handle_count() }
+
+///|
+#cfg(platform="windows")
+fn restricted_pipe_open(name : @os_string.OsString) -> Int { @pipe_test_support.restricted_pipe_open(name) }
+
+///|
+#cfg(platform="windows")
+async test "pipe denies restricted token then accepts normal user" {
+  let control_name = @os_string.encode("\\\\.\\pipe\\metonic_acl_control.\{@env_util.current_process}")
+  let control = @fd_util.create_named_pipe_server(control_name, is_async=true)
+  if !@fd_util.fd_is_valid(control) { @os_error.check_errno("create default ACL control") }
+  let control_handle = IoHandle::from_fd(control, kind=Pipe)
+  defer control_handle.close()
+  assert_eq(restricted_pipe_open(control_name), 0)
+  let path = "\\\\.\\pipe\\metonic_acl.\{@env_util.current_process}"
+  let name = @os_string.encode(path)
+  let fd = @fd_util.create_private_duplex_pipe(name)
+  if !@fd_util.fd_is_valid(fd) { @os_error.check_errno("create ACL pipe") }
+  let server = IoHandle::from_fd(fd, kind=Pipe)
+  defer server.close()
+  assert_eq(restricted_pipe_open(name), 5)
+  let client = @fs.open(path, mode=ReadWrite)
+  defer client.close()
+  @async.with_timeout(500, () => server.accept_pipe())
+}
+
+///|
+#cfg(platform="windows")
+async test "pipe cancellation and close release endpoint and handles" {
+  let path = @os_string.encode("\\\\.\\pipe\\metonic_close.\{@env_util.current_process}")
+  // Initialize the timeout machinery before measuring endpoint-owned handles.
+  ignore(@async.with_timeout_opt(1, () => @async.sleep(10)))
+  let before = process_handle_count()
+  assert_true(before > 0)
+  for _ in 0..<32 {
+    let fd = @fd_util.create_private_duplex_pipe(path)
+    if !@fd_util.fd_is_valid(fd) {
+      @os_error.check_errno("recreate closed endpoint")
+    }
+    let server = IoHandle::from_fd(fd, kind=Pipe)
+    assert_true(@async.with_timeout_opt(1, () => server.accept_pipe()) is None)
+    server.close()
+    server.close()
+  }
+  let after = process_handle_count()
+  assert_true(after > 0 && after <= before)
+}
+
+///|
+#cfg(platform="windows")
+async test "pipe accepts early and delayed clients and transfers both ways" {
+  for early in [true, false] {
+    let path = "\\\\.\\pipe\\metonic_duplex.\{@env_util.current_process}"
+    let fd = @fd_util.create_private_duplex_pipe(@os_string.encode(path))
+    if !@fd_util.fd_is_valid(fd) {
+      @os_error.check_errno("create duplex pipe")
+    }
+    let server = IoHandle::from_fd(fd, kind=Pipe)
+    defer server.close()
+    @async.with_timeout(2000, () => {
+      @async.with_task_group() <| group => {
+        group.spawn_bg() <| () => {
+          if !early { @async.sleep(20) }
+          let client = @fs.open(path, mode=ReadWrite)
+          defer client.close()
+          client.write(b"ping")
+          assert_eq(client.read_exactly(4), b"pong")
+        }
+        if early { @async.sleep(20) }
+        server.accept_pipe()
+        let buf = FixedArray::make(4, b'\x00')
+        assert_eq(server.read(buf, offset=0, len=4, context="server read"), 4)
+        assert_eq(Bytes::from_array(Array::makei(4, i => buf[i])), b"ping")
+        assert_eq(server.write(b"pong", offset=0, len=4, context="server write"), 4)
+      }
+    })
+  }
+}
+
+///|
+#cfg(platform="windows")
+async test "pipe reconnects after disconnect and recovers from cancelled read" {
+  let path = "\\\\.\\pipe\\metonic_reconnect.\{@env_util.current_process}"
+  let fd = @fd_util.create_private_duplex_pipe(@os_string.encode(path))
+  if !@fd_util.fd_is_valid(fd) {
+    @os_error.check_errno("create reconnect pipe")
+  }
+  let server = IoHandle::from_fd(fd, kind=Pipe)
+  defer server.close()
+  @async.with_timeout(2000, () => {
+    for _ in 0..<3 {
+      @async.with_task_group() <| group => {
+        group.spawn_bg() <| () => {
+          let client = @fs.open(path, mode=ReadWrite)
+          defer client.close()
+          @async.sleep(40)
+          client.write(b"x")
+          assert_eq(client.read_exactly(1), b"y")
+        }
+        server.accept_pipe()
+        let buf = FixedArray::make(1, b'\x00')
+        assert_true(@async.with_timeout_opt(10, () => {
+          server.read(buf, offset=0, len=1, context="cancel read")
+        }) is None)
+        assert_eq(server.read(buf, offset=0, len=1, context="read after cancel"), 1)
+        assert_eq(buf[0], b'x')
+        assert_eq(server.write(b"y", offset=0, len=1, context="reply"), 1)
+      }
+      server.disconnect_pipe()
+    }
+  })
+}
diff --git a/src/internal/event_loop/pipe_windows.mbt b/src/internal/event_loop/pipe_windows.mbt
new file mode 100644
index 0000000..997fb9b
--- /dev/null
+++ b/src/internal/event_loop/pipe_windows.mbt
@@ -0,0 +1,38 @@
+///|
+#cfg(platform="windows")
+extern "C" fn IoResult::for_pipe_connect() -> IoResult = "moonbitlang_async_make_pipe_connect_io_result"
+
+///|
+#cfg(platform="windows")
+extern "C" fn connect_pipe_ffi(fd : @fd_util.Fd, result : IoResult) -> Int = "moonbitlang_async_connect_pipe"
+
+///|
+#cfg(platform="windows")
+extern "C" fn disconnect_pipe_ffi(fd : @fd_util.Fd) -> Int = "moonbitlang_async_disconnect_pipe_checked"
+
+///|
+#cfg(platform="windows")
+pub fn IoHandle::disconnect_pipe(self : IoHandle) -> Unit raise {
+  guard! self.read is Idle
+  guard! self.write is Idle
+  if disconnect_pipe_ffi(self.fd) == 0 {
+    @os_error.check_errno("disconnect named pipe")
+  }
+}
+
+///|
+#cfg(platform="windows")
+pub async fn IoHandle::accept_pipe(self : IoHandle) -> Unit {
+  @coroutine.check_cancellation()
+  guard! self.read is Idle
+  let context = "accept named pipe"
+  let result = IoResult::for_pipe_connect()
+  defer result.free()
+  if connect_pipe_ffi(self.fd, result) == 0 {
+    if !@os_error.is_nonblocking_io_error() {
+      @os_error.check_errno(context)
+    }
+    self.wait_read_result(result, context~)
+    ignore(result.status(self.fd, context~))
+  }
+}

diff --git a/src/named_pipe/stub.c b/src/named_pipe/stub.c
new file mode 100644
index 0000000..bb8d4cb
--- /dev/null
+++ b/src/named_pipe/stub.c
@@ -0,0 +1,62 @@
+#include <moonbit.h>
+#ifdef _WIN32
+#include <windows.h>
+#include <aclapi.h>
+#include <stdlib.h>
+#include "../internal/event_loop/io_result_windows.h"
+#pragma comment(lib, "advapi32.lib")
+MOONBIT_FFI_EXPORT
+HANDLE moonbitlang_async_create_private_duplex_pipe(const WCHAR *name) {
+  HANDLE token = NULL;
+  TOKEN_USER *user = NULL;
+  PACL acl = NULL;
+  HANDLE pipe = INVALID_HANDLE_VALUE;
+  DWORD size = 0, error = ERROR_SUCCESS;
+  SECURITY_DESCRIPTOR descriptor;
+  EXPLICIT_ACCESSW access = {0};
+  SECURITY_ATTRIBUTES attributes = {sizeof(SECURITY_ATTRIBUTES), &descriptor, FALSE};
+  if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token)) return pipe;
+  GetTokenInformation(token, TokenUser, NULL, 0, &size);
+  if (GetLastError() != ERROR_INSUFFICIENT_BUFFER) goto cleanup;
+  user = (TOKEN_USER *)malloc(size);
+  if (!user) { SetLastError(ERROR_NOT_ENOUGH_MEMORY); goto cleanup; }
+  if (!GetTokenInformation(token, TokenUser, user, size, &size)) goto cleanup;
+  access.grfAccessPermissions = FILE_GENERIC_READ | FILE_GENERIC_WRITE;
+  access.grfAccessMode = SET_ACCESS;
+  access.grfInheritance = NO_INHERITANCE;
+  access.Trustee.TrusteeForm = TRUSTEE_IS_SID;
+  access.Trustee.TrusteeType = TRUSTEE_IS_USER;
+  access.Trustee.ptstrName = (LPWSTR)user->User.Sid;
+  error = SetEntriesInAclW(1, &access, NULL, &acl);
+  if (error != ERROR_SUCCESS) { SetLastError(error); goto cleanup; }
+  if (!InitializeSecurityDescriptor(&descriptor, SECURITY_DESCRIPTOR_REVISION) ||
+      !SetSecurityDescriptorDacl(&descriptor, TRUE, acl, FALSE) ||
+      !SetSecurityDescriptorOwner(&descriptor, user->User.Sid, FALSE)) goto cleanup;
+  pipe = CreateNamedPipeW(name,
+    PIPE_ACCESS_DUPLEX | FILE_FLAG_OVERLAPPED | FILE_FLAG_FIRST_PIPE_INSTANCE,
+    PIPE_TYPE_BYTE | PIPE_READMODE_BYTE | PIPE_WAIT | PIPE_REJECT_REMOTE_CLIENTS,
+    1, 4096, 4096, 0, &attributes);
+cleanup:
+  error = GetLastError();
+  if (acl) LocalFree(acl);
+  free(user);
+  CloseHandle(token);
+  SetLastError(error);
+  return pipe;
+}
+
+MOONBIT_FFI_EXPORT
+int32_t moonbitlang_async_disconnect_pipe_checked(HANDLE pipe) { return DisconnectNamedPipe(pipe); }
+MOONBIT_FFI_EXPORT
+struct IoResult *moonbitlang_async_make_pipe_connect_io_result(void) {
+  struct IoResult *result = calloc(1, sizeof(struct IoResult));
+  if (!result) moonbit_panic();
+  result->kind = PipeConnect; result->event = IO_RESULT_READ_EVENT; return result;
+}
+MOONBIT_FFI_EXPORT
+int32_t moonbitlang_async_connect_pipe(HANDLE pipe, struct IoResult *result) {
+  if (ConnectNamedPipe(pipe, &result->overlapped)) return 1;
+  if (GetLastError() == ERROR_PIPE_CONNECTED) return 1;
+  return 0;
+}
+#endif
diff --git a/src/named_pipe/windows_pipe.mbt b/src/named_pipe/windows_pipe.mbt
new file mode 100644
index 0000000..e950883
--- /dev/null
+++ b/src/named_pipe/windows_pipe.mbt
@@ -0,0 +1,60 @@
+///|
+#cfg(platform="windows")
+pub struct WindowsPipe {
+  priv io : @event_loop.IoHandle
+  priv path : String
+  priv mut buffer : @io.ReaderBuffer
+}
+
+///|
+#cfg(platform="windows")
+pub suberror PipeNameError { InvalidName } derive(Debug)
+
+///|
+#cfg(platform="windows")
+pub fn WindowsPipe::listen(name : String) -> WindowsPipe raise {
+  guard name.length() > 0 && name.length() <= 128 &&
+    name.to_array().all(c => (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+      (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.') else {
+    raise PipeNameError::InvalidName
+  }
+  let path = "\\\\.\\pipe\\" + name
+  let fd = @fd_util.create_private_duplex_pipe(@os_string.encode(path))
+  if !@fd_util.fd_is_valid(fd) { @os_error.check_errno("create Windows pipe") }
+  { io: @event_loop.IoHandle::from_fd(fd, kind=Pipe), path, buffer: @io.ReaderBuffer::new() }
+}
+
+///|
+#cfg(platform="windows")
+pub fn WindowsPipe::path(self : WindowsPipe) -> String { self.path }
+
+///|
+#cfg(platform="windows")
+pub async fn WindowsPipe::accept(self : WindowsPipe) -> Unit { self.io.accept_pipe() }
+
+///|
+#cfg(platform="windows")
+pub fn WindowsPipe::disconnect(self : WindowsPipe) -> Unit raise {
+  self.io.disconnect_pipe()
+  self.buffer = @io.ReaderBuffer::new()
+}
+
+///|
+#cfg(platform="windows")
+pub fn WindowsPipe::close(self : WindowsPipe) -> Unit { self.io.close() }
+
+///|
+#cfg(platform="windows")
+pub impl @io.Reader for WindowsPipe with fn _direct_read(self, buf, offset~, max_len~) {
+  self.io.read(buf, offset~, len=max_len, context="Windows pipe read")
+}
+
+///|
+#cfg(platform="windows")
+pub impl @io.Reader for WindowsPipe with fn _get_internal_buffer(self) { self.buffer }
+
+///|
+#cfg(platform="windows")
+pub impl @io.Writer for WindowsPipe with fn write_once(self, buf, offset~, len~) {
+  self.io.write(buf, offset~, len~, context="Windows pipe write")
+}

+++ b/src/named_pipe/windows_pipe_test.mbt
@@ -0,0 +1,22 @@
+///|
+#cfg(platform="windows")
+async test "public Windows pipe reconnect does not reuse buffered client text" {
+  let server = @named_pipe.WindowsPipe::listen("metonic_public_pipe_test")
+  defer server.close()
+  @async.with_timeout(2000, () => {
+    for value in ["a", "c"] {
+      @async.with_task_group() <| group => {
+        group.spawn_bg() <| () => {
+          let client = @fs.open(server.path(), mode=ReadWrite)
+          defer client.close()
+          client.write(value + "\nstale\n")
+          assert_eq(client.read_exactly(1), b"x")
+        }
+        server.accept()
+        assert_eq(server.read_until("\n"), Some(value))
+        server.write(b"x")
+      }
+      server.disconnect()
+    }
+  })
+}
